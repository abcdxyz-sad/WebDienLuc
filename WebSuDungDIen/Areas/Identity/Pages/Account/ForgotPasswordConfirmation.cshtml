@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Xác nhận gửi email";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản lý Điện Lực</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <style>
        body {
            background-color: #f4f7f6;
            font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        }

        .auth-wrapper {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            padding: 20px;
        }

        .auth-card {
            width: 100%;
            max-width: 480px;
        }

        /* Nút bấm thanh lịch giống trang ResetPassword */
        .btn-custom {
            background-color: #0d6efd;
            color: #fff;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            font-size: 1rem;
            padding: 12px;
            transition: all 0.2s;
            box-shadow: 0 4px 6px rgba(13, 110, 253, 0.2);
        }

            .btn-custom:hover {
                background-color: #0b5ed7;
                transform: translateY(-1px);
                box-shadow: 0 6px 8px rgba(13, 110, 253, 0.3);
                color: #fff;
            }

        /* Icon tròn tròn trên cùng (Màu xanh lá cây thân thiện) */
        .icon-circle {
            width: 80px;
            height: 80px;
            background-color: rgba(25, 135, 84, 0.1);
            color: #198754;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px auto;
            font-size: 36px;
        }
    </style>
</head>

<body>
    <div class="auth-wrapper">
        <div class="auth-card">

            <div class="card border-0 bg-white text-center p-4 p-md-5" style="border-radius: 16px; box-shadow: 0 10px 30px rgba(0,0,0,0.08);">

                <div class="icon-circle">
                    <i class="fas fa-envelope-open-text"></i>
                </div>

                <h3 class="fw-bold text-dark mb-3">Kiểm tra hộp thư của bạn</h3>

                <p class="text-muted mb-4" style="font-size: 1.05rem; line-height: 1.6;">
                    Chúng tôi đã gửi một liên kết hướng dẫn đặt lại mật khẩu an toàn đến địa chỉ email của bạn.
                </p>

                <div class="alert alert-warning border-0 text-start p-3 mb-4" style="background-color: #fff3cd; color: #664d03; border-radius: 8px; font-size: 0.95rem;">
                    <div class="d-flex">
                        <i class="fas fa-exclamation-circle mt-1 me-2 text-warning fs-5"></i>
                        <span>
                            <strong>Lưu ý:</strong> Vui lòng kiểm tra cả mục <em>Thư rác (Spam)</em> nếu bạn không tìm thấy email trong Hộp thư đến.
                        </span>
                    </div>
                </div>

                <a asp-page="./Login" class="w-100 btn btn-custom d-flex justify-content-center align-items-center">
                    <i class="fas fa-arrow-left me-2"></i> Trở về trang Đăng nhập
                </a>

            </div>

            <div class="text-center mt-4">
                <p class="text-muted small mb-0">Hệ Thống Quản Lý Điện Lực &copy; @DateTime.Now.Year</p>
            </div>

        </div>
    </div>
</body>
</html>