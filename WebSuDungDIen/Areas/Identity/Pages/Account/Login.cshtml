@page
@model LoginModel

@{
    ViewData["Title"] = "Đăng nhập hệ thống";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập - Quản lý Điện Lực</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/Login.css" asp-append-version="true" />
</head>
<body>

    <div class="zzz-login-wrapper">
        <div class="zzz-login-card">
            <div class="zzz-login-header">
                <h1 class="zzz-title">HỆ THỐNG QUẢN LÝ</h1>
                <p class="zzz-subtitle"><span class="status-dot"></span> Vui lòng đăng nhập</p>
            </div>

            <form id="account" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3 font-monospace font-weight-bold"></div>

                <div class="zzz-input-group mb-4">
                    <input asp-for="Input.UserName" class="zzz-input" autocomplete="username" spellcheck="false" required placeholder="nhap" />
                    <label asp-for="Input.UserName" class="zzz-label label-user">Tên đăng nhập</label>
                    <span asp-validation-for="Input.UserName" class="text-danger small mt-1 d-block font-weight-bold font-monospace"></span>
                </div>

                <div class="zzz-input-group mb-4">
                    <input asp-for="Input.Password" class="zzz-input" autocomplete="current-password" required placeholder="nhap" />
                    <label asp-for="Input.Password" class="zzz-label label-pass">Mật khẩu</label>
                    <span asp-validation-for="Input.Password" class="text-danger small mt-1 d-block font-weight-bold font-monospace"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-4">

                    <div class="checkbox zzz-remember mb-0">
                        <label asp-for="Input.RememberMe" style="cursor: pointer; display: flex; align-items: center; gap: 8px; margin: 0;">
                            <input class="form-check-input" asp-for="Input.RememberMe" />
                            Ghi nhớ đăng nhập
                        </label>
                    </div>

                    <button type="button" class="zzz-eye-btn-bottom" id="togglePassword">
                        <i class="fas fa-eye"></i> HIỂN THỊ
                    </button>

                </div>

                <button id="login-submit" type="submit" class="w-100 btn btn-lg zzz-login-btn">
                    Đăng Nhập
                </button>

                <div class="zzz-links">
                    <a id="forgot-password" asp-page="./ForgotPassword">> Quên mật khẩu?</a>
                    <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">> Tạo tài khoản</a>
                </div>
            </form>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.getElementById('togglePassword').addEventListener('click', function (e) {
            const passwordInput = document.getElementById('Input_Password');
            const icon = this.querySelector('i');

            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');

                /* Đảo màu nút để cảnh báo "Đang lộ mật khẩu" */
                this.style.backgroundColor = 'var(--zzz-black)';
                this.style.color = 'var(--zzz-primary)';
            } else {
                passwordInput.type = 'password';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');

                /* Trả về bình thường */
                this.style.backgroundColor = 'transparent';
                this.style.color = 'var(--zzz-black)';
            }
        });
    </script>
</body>
</html>