@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Thiết lập mật khẩu mới";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản lý Điện Lực</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

    <style>
        body {
            background-color: #f4f7f6;
            font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        }

        .auth-wrapper {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            padding: 20px;
        }

        .auth-card {
            width: 100%;
            max-width: 450px;
        }

        /* Form style chuẩn Khách hàng: Mềm mại, hiện đại */
        .form-control-custom {
            border: 1px solid #ced4da;
            border-radius: 8px;
            padding: 12px 15px;
            font-size: 1rem;
            color: #495057;
            transition: all 0.2s ease-in-out;
        }

            .form-control-custom:focus {
                border-color: #86b7fe;
                box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.15);
                outline: none;
            }

            .form-control-custom[readonly] {
                background-color: #f8f9fa;
                color: #6c757d;
                font-weight: 500;
            }

        /* Nút bấm thanh lịch */
        .btn-custom {
            background-color: #0d6efd;
            color: #fff;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            font-size: 1rem;
            padding: 12px;
            transition: all 0.2s;
            box-shadow: 0 4px 6px rgba(13, 110, 253, 0.2);
        }

            .btn-custom:hover {
                background-color: #0b5ed7;
                transform: translateY(-1px);
                box-shadow: 0 6px 8px rgba(13, 110, 253, 0.3);
                color: #fff;
            }

            .btn-custom:active {
                transform: translateY(0);
                box-shadow: 0 2px 4px rgba(13, 110, 253, 0.2);
            }

        /* Icon tròn tròn trên cùng */
        .icon-circle {
            width: 64px;
            height: 64px;
            background-color: rgba(13, 110, 253, 0.1);
            color: #0d6efd;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px auto;
            font-size: 28px;
        }
    </style>
</head>
<body>
    <div class="auth-wrapper">
        <div class="auth-card">

            <div class="card border-0 bg-white" style="border-radius: 16px; box-shadow: 0 10px 30px rgba(0,0,0,0.08);">

                <div class="card-body p-4 p-md-5">

                    <div class="text-center mb-4">
                        <div class="icon-circle">
                            <i class="fas fa-shield-alt"></i>
                        </div>
                        <h4 class="fw-bold text-dark mb-2">Tạo mật khẩu mới</h4>
                        <p class="text-muted small">Vui lòng thiết lập mật khẩu bảo mật cho tài khoản của bạn.</p>
                    </div>

                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 rounded-3 small mb-4" role="alert" style="background-color: #f8d7da; color: #842029;"></div>

                        <input asp-for="Input.Code" type="hidden" />

                        <div class="mb-3">
                            <label asp-for="Input.Email" class="form-label text-muted small fw-bold">Tài khoản Email</label>
                            <input asp-for="Input.Email" class="form-control form-control-custom" autocomplete="username" aria-required="true" readonly />
                            <span asp-validation-for="Input.Email" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.Password" class="form-label text-muted small fw-bold">Mật khẩu mới</label>
                            <input asp-for="Input.Password" class="form-control form-control-custom" autocomplete="new-password" aria-required="true" placeholder="Mật khẩu tối thiểu 6 ký tự" />
                            <span asp-validation-for="Input.Password" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Input.ConfirmPassword" class="form-label text-muted small fw-bold">Xác nhận mật khẩu</label>
                            <input asp-for="Input.ConfirmPassword" class="form-control form-control-custom" autocomplete="new-password" aria-required="true" placeholder="Nhập lại mật khẩu vừa tạo" />
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <button type="submit" class="w-100 btn btn-custom">
                            Xác nhận thay đổi
                        </button>
                    </form>
                </div>

            </div>

            <div class="text-center mt-4">
                <p class="text-muted small mb-0">Hệ Thống Quản Lý Điện Lực &copy; @DateTime.Now.Year</p>
            </div>

        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>