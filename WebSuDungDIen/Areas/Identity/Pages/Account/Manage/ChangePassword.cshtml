@page
@model ChangePasswordModel
@{
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
    // MÁY QUÉT NHÂN PHẨM CHÍNH HIỆU: Chỉ hoạt động khi đã Login!
    bool isStaff = User.Identity?.IsAuthenticated == true && (User.IsInRole("Admin") || User.IsInRole("NhanVien"));
}
<partial name="_StatusMessage" for="StatusMessage" />

@if (isStaff)
{
    @* =========================================================================
       GIAO DIỆN ĐẶC VỤ (ZZZ STYLE) - TỐI TĂM, BẠO LỰC
       ========================================================================= *@
    <div class="d-flex align-items-center justify-content-between border-bottom border-dark border-3 pb-3 mb-4">
        <h3 class="m-0 zzz-text-mono fw-black text-uppercase border-start border-5 ps-3" style="border-left-color: var(--zzz-primary) !important; letter-spacing: 1px;">
            Thông tin tài khoản
        </h3>
        <span class="badge text-dark rounded-0 border border-dark border-2 fs-6 zzz-text-mono px-3 py-2 shadow-sm d-none d-md-block"
              style="background-color: var(--zzz-primary); box-shadow: 2px 2px 0px #000 !important;">
            <span class="text-dark zzz-blink-dot">●</span> PROTECTED
        </span>
    </div>

    <form id="change-password-form" method="post" asp-page-handler="ChangePassword" class="zzz-terminal-form">
        <div asp-validation-summary="ModelOnly" class="text-danger fw-bold mb-3 zzz-text-mono" role="alert"></div>

        <div class="row g-4 p-4 bg-light border border-dark border-3 position-relative mt-2" style="box-shadow: inset 4px 4px 0px rgba(0,0,0,0.05);">

            <span class="position-absolute text-dark border border-dark border-2 px-3 py-1 fw-bold zzz-text-mono shadow-sm" style="top: -16px; right: 20px; background-color: var(--zzz-primary); width: max-content; z-index: 10;">
                AUTH_REQUIRED
            </span>

            <div class="col-md-6">
                <label asp-for="Input.Username" class="zzz-label fw-bold text-muted small text-uppercase mb-1">>_ TÊN ĐĂNG NHẬP <span class="text-danger">*</span></label>
                <div class="input-group border-dark border-2 shadow-sm">
                    <span class="input-group-text bg-dark text-white border-0 rounded-0 d-flex justify-content-center" style="width: 45px;"><i class="fas fa-user-astronaut"></i></span>
                    <input asp-for="Input.Username" class="form-control border-0 rounded-0 fw-bold fs-5 text-dark" aria-required="true" placeholder="Nhập tên đăng nhập..." style="background-color: #fff;" />
                </div>
                <span asp-validation-for="Input.Username" class="text-danger small fw-bold zzz-text-mono mt-1 d-block"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Input.Email" class="zzz-label fw-bold text-muted small text-uppercase mb-1">>_ HỘP THƯ EMAIL <span class="text-danger">*</span></label>
                <div class="input-group border-dark border-2 shadow-sm">
                    <span class="input-group-text bg-dark text-white border-0 rounded-0 d-flex justify-content-center" style="width: 45px;"><i class="fas fa-envelope"></i></span>
                    <input asp-for="Input.Email" class="form-control border-0 rounded-0 fw-bold fs-5 text-dark" aria-required="true" placeholder="Nhập email..." style="background-color: #fff;" />
                </div>
                <span asp-validation-for="Input.Email" class="text-danger small fw-bold zzz-text-mono mt-1 d-block"></span>
            </div>

            <div class="col-12 my-1">
                <hr class="border-dark border-2 opacity-25 m-0" style="border-style: dashed !important;">
            </div>

            <div class="col-md-12">
                <label asp-for="Input.OldPassword" class="zzz-label fw-bold text-muted small text-uppercase mb-1">>_ MẬT KHẨU CŨ <span class="text-muted fw-normal">(Bỏ trống nếu không đổi)</span></label>
                <div class="input-group border-dark border-2 shadow-sm">
                    <span class="input-group-text bg-dark text-white border-0 rounded-0 d-flex justify-content-center" style="width: 45px;"><i class="fas fa-unlock-alt"></i></span>
                    <input asp-for="Input.OldPassword" type="password" class="form-control border-0 rounded-0 fw-bold fs-5" autocomplete="current-password" aria-required="true" placeholder="Chỉ nhập khi muốn đổi pass mới..." style="background-color: #fff;" />
                </div>
                <span asp-validation-for="Input.OldPassword" class="text-danger small fw-bold zzz-text-mono mt-1 d-block"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Input.NewPassword" class="zzz-label fw-bold text-muted small text-uppercase mb-1">>_ MẬT KHẨU MỚI <span class="text-danger">*</span></label>
                <div class="input-group border-dark border-2 shadow-sm">
                    <span class="input-group-text bg-dark text-white border-0 rounded-0 d-flex justify-content-center" style="width: 45px;"><i class="fas fa-key"></i></span>
                    <input asp-for="Input.NewPassword" type="password" class="form-control border-0 rounded-0 fw-bold fs-5 text-danger" autocomplete="new-password" aria-required="true" placeholder="Tạo mật khẩu mới..." style="background-color: #fff;" />
                </div>
                <span asp-validation-for="Input.NewPassword" class="text-danger small fw-bold zzz-text-mono mt-1 d-block"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Input.ConfirmPassword" class="zzz-label fw-bold text-muted small text-uppercase mb-1">>_ XÁC NHẬN MẬT KHẨU <span class="text-danger">*</span></label>
                <div class="input-group border-dark border-2 shadow-sm">
                    <span class="input-group-text bg-dark text-white border-0 rounded-0 d-flex justify-content-center" style="width: 45px;"><i class="fas fa-check-double"></i></span>
                    <input asp-for="Input.ConfirmPassword" type="password" class="form-control border-0 rounded-0 fw-bold fs-5 text-danger" autocomplete="new-password" aria-required="true" placeholder="Nhập lại mật khẩu mới..." style="background-color: #fff;" />
                </div>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger small fw-bold zzz-text-mono mt-1 d-block"></span>
            </div>

            <div class="col-12 mt-4 text-end border-top border-dark border-3 pt-4">
                <button type="submit" class="btn btn-primary px-5 py-3 zzz-text-mono fs-5 fw-bold d-inline-flex align-items-center justify-content-center">
                    <i class="fas fa-sync-alt me-2" style="margin-top: -2px;"></i> LƯU THAY ĐỔI HỒ SƠ
                </button>
            </div>
        </div>
    </form>
}
else
{
    @* =========================================================================
       GIAO DIỆN KHÁCH HÀNG (CORPORATE STYLE) - MƯỢT MÀ, THÂN THIỆN
       ========================================================================= *@
    <h3 class="fw-bold mb-4 text-primary">
        <i class="bi bi-shield-lock me-2"></i>Bảo mật & Đăng nhập
    </h3>

    <div class="card shadow-sm border-0" style="border-radius: 15px; background: #ffffff;">
        <div class="card-body p-4 p-md-5">
            <form id="change-password-form" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-4 fw-semibold" role="alert"></div>

                <div class="row g-5">
                    <div class="col-lg-5">
                        <h5 class="fw-bold text-dark mb-4 pb-2 border-bottom">
                            <i class="bi bi-person-vcard text-primary me-2"></i>1. Thông tin tài khoản
                        </h5>

                        <div class="mb-4">
                            <label asp-for="Input.Username" class="form-label fw-bold text-muted small text-uppercase mb-2">Tên đăng nhập</label>
                            <input asp-for="Input.Username" class="form-control border rounded-3 shadow-sm py-2 fw-semibold text-dark" />
                            <span asp-validation-for="Input.Username" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Input.Email" class="form-label fw-bold text-muted small text-uppercase mb-2">Hộp thư Email</label>
                            <input asp-for="Input.Email" class="form-control border rounded-3 shadow-sm py-2 fw-semibold text-dark" placeholder="Nhập email..." />
                            <span asp-validation-for="Input.Email" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>

                    <div class="col-lg-7">
                        <h5 class="fw-bold text-dark mb-4 pb-2 border-bottom d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-key text-danger me-2"></i>2. Đổi mật khẩu</span>
                            <span class="badge bg-light text-muted border fw-normal fs-6">Bỏ trống nếu không đổi</span>
                        </h5>

                        <div class="mb-4">
                            <label asp-for="Input.OldPassword" class="form-label fw-bold text-muted small text-uppercase mb-2">Mật khẩu hiện tại</label>
                            <input asp-for="Input.OldPassword" class="form-control border rounded-3 shadow-sm py-2 fw-semibold text-dark" autocomplete="current-password" placeholder="Chỉ nhập khi muốn đổi pass mới..." />
                            <span asp-validation-for="Input.OldPassword" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="row bg-light p-3 rounded-3 border mx-0 mb-4">
                            <div class="col-md-6 mb-3 mb-md-0">
                                <label asp-for="Input.NewPassword" class="form-label fw-bold text-muted small text-uppercase mb-2">Mật khẩu mới</label>
                                <input asp-for="Input.NewPassword" class="form-control border rounded-3 shadow-sm py-2 fw-semibold text-danger" autocomplete="new-password" placeholder="Nhập mật khẩu mới..." />
                                <span asp-validation-for="Input.NewPassword" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Input.ConfirmPassword" class="form-label fw-bold text-muted small text-uppercase mb-2">Xác nhận mật khẩu mới</label>
                                <input asp-for="Input.ConfirmPassword" class="form-control border rounded-3 shadow-sm py-2 fw-semibold text-danger" autocomplete="new-password" placeholder="Nhập lại mật khẩu mới..." />
                                <span asp-validation-for="Input.ConfirmPassword" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <hr class="my-4 text-muted">

                <div class="d-flex justify-content-end">
                    <button type="submit" class="btn btn-primary corp-btn-primary rounded-3 py-2 px-5 fw-bold shadow-sm" style="font-size: 1.1rem;">
                        <i class="bi bi-shield-check me-2"></i> Lưu thay đổi hồ sơ
                    </button>
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}