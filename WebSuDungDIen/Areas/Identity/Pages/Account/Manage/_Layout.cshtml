@{
    // 1. Kiểm tra Role
    bool isAdminOrStaff = User.IsInRole("Admin") || User.IsInRole("NhanVien");

    // 2. Load Layout tổng tương ứng
    Layout = "/Views/Shared/_Layout.cshtml";
}

@if (isAdminOrStaff)
{
    @* ========================================================
       LAYOUT CHO ADMIN (ZZZ STYLE - HỔN LOẠN & HIPHOP)
       ======================================================== *@
    <div class="zzz-manage-container py-5">
        <div class="zzz-urban-card p-4 border-dark border-3" style="box-shadow: 12px 12px 0px #000;">
            <h2 class="zzz-section-title mb-4" style="transform: skewX(-10deg);">
                <i class="bi bi-shield-lock-fill"></i> ADMIN_CORE [SETUP]
            </h2>
            <div class="row g-4">
                <div class="col-md-3">
                    <partial name="_ManageNav" />
                </div>
                <div class="col-md-9 border-start border-dark border-3 ps-md-4">
                    <div class="zzz-admin-content-well">
                        @RenderBody()
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    @* ========================================================
       LAYOUT CHO KHÁCH HÀNG (CORP STYLE - SANG TRỌNG)
       ======================================================== *@
    <div class="corp-wrapper">
        <div class="manage-custom-container py-5">
            <div class="manage-card-glass border-0 shadow-lg" style="border-radius: 20px; background: #fff;">
                <div class="manage-header-zone p-4 border-bottom bg-light">
                    <h4 class="fw-bold text-primary mb-0"><i class="bi bi-person-circle"></i> Trung tâm tài khoản</h4>
                </div>
                <div class="manage-main-body p-4">
                    <nav class="manage-tabs mb-4 border-bottom">
                        <partial name="_ManageNav" />
                    </nav>
                    <div class="manage-content-well">
                        @RenderBody()
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    @RenderSection("Scripts", required: false)
}