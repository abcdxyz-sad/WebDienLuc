@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Khôi phục mật khẩu";
    Layout = null; // Cắt đứt với giao diện mặc định để theo hệ "ZZZ"
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản lý Điện Lực</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/Login.css" asp-append-version="true" />
</head>
<body>

    <div class="zzz-login-wrapper">
        <div class="zzz-login-card" style="max-width: 520px;">
            <div class="zzz-login-header">
                <h1 class="zzz-title">QUÊN MẬT KHẨU?</h1>
                <p class="zzz-subtitle"><span class="status-dot"></span> Nhập Email để lấy lại quyền truy cập</p>
            </div>

            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3 font-monospace font-weight-bold"></div>

                <div class="zzz-input-group mb-4">
                    <input asp-for="Input.Email" class="zzz-input" autocomplete="email" aria-required="true" spellcheck="false" required placeholder=" " />

                    <label class="zzz-label label-reg-email" asp-for="Input.Email">Email</label>

                    <span asp-validation-for="Input.Email" class="text-danger small mt-1 d-block font-weight-bold font-monospace"></span>
                </div>

                <button type="submit" class="w-100 btn btn-lg zzz-login-btn">
                    GỬI YÊU CẦU RESET
                </button>

                <div class="zzz-links">
                    <a asp-page="./Login"> < Quay lại đăng nhập</a>
                </div>
            </form>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>