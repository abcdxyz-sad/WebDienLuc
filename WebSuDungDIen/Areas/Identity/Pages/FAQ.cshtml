<style>
    /* 💥 TÀ THUẬT 4 GÓC NGẮM BẮN (BẢN NÂNG CẤP) */
    .zzz-target-box {
        position: relative;
        padding: 40px 45px;
        background-color: #ffffff;
        background-image: linear-gradient(to right,#111 100%,transparent 0),linear-gradient(to bottom,#111 100%,transparent 0),linear-gradient(to left,#111 100%,transparent 0),linear-gradient(to bottom,#111 100%,transparent 0),linear-gradient(to right,#111 100%,transparent 0),linear-gradient(to top,#111 100%,transparent 0),linear-gradient(to left,#111 100%,transparent 0),linear-gradient(to top,#111 100%,transparent 0);
        background-position: 0 0,0 0,100% 0,100% 0,0 100%,0 100%,100% 100%,100% 100%;
        background-repeat: no-repeat;
        background-size: 35px 5px,5px 35px,35px 5px,5px 35px,35px 5px,5px 35px,35px 5px,5px 35px;
        overflow: hidden;
        box-shadow: 8px 8px 0px rgba(0,0,0,0.05);
    }

        /* Lưới HUD */
        .zzz-target-box::before {
            content: "";
            position: absolute;
            inset: 0;
            background-image: radial-gradient(#d1d1d1 2px,transparent 2px);
            background-size: 20px 20px;
            opacity: 0.6;
            z-index: 0;
        }

        .zzz-target-box > div {
            position: relative;
            z-index: 1;
        }

    /* 💥 SỌC CẢNH BÁO */
    .zzz-vertical-hazard {
        width: 10px;
        background: repeating-linear-gradient(-45deg,#111,#111 10px,var(--zzz-primary,#D2FF00) 10px,var(--zzz-primary,#D2FF00) 20px);
        border: 2px solid #111;
        animation: hazard-scroll 2s linear infinite;
    }

    @@keyframes hazard-scroll {
        100%

    {
        background-position: 0 28px;
    }

    }

    /* ACCORDION */
    .zzz-collapse-trigger {
        cursor: pointer;
        transition: all .25s cubic-bezier(.25,.8,.25,1);
        position: relative;
        z-index: 1;
        border: 2px solid transparent;
    }

        .zzz-collapse-trigger:hover {
            background-color: #111 !important;
            color: #fff !important;
            padding-left: 20px !important;
            border: 2px solid #111;
            box-shadow: 5px 5px 0 var(--zzz-primary,#D2FF00);
        }

            .zzz-collapse-trigger:hover h4,
            .zzz-collapse-trigger:hover p,
            .zzz-collapse-trigger:hover i {
                color: #fff !important;
            }

    .zzz-collapse-icon {
        transition: transform .4s cubic-bezier(.4,0,.2,1);
    }

    .zzz-collapse-trigger:not(.collapsed) {
        background-color: var(--zzz-primary,#D2FF00) !important;
        color: #111 !important;
        border: 2px solid #111;
        border-bottom: 4px solid #111 !important;
    }

        .zzz-collapse-trigger:not(.collapsed) h4,
        .zzz-collapse-trigger:not(.collapsed) p,
        .zzz-collapse-trigger:not(.collapsed) i {
            color: #111 !important;
        }

        .zzz-collapse-trigger:not(.collapsed) .zzz-collapse-icon {
            transform: rotate(180deg) scale(1.3);
            color: #FF3366 !important;
        }

    /* --- PHẦN SUBQUEST (ĐÃ FIX LỖI KẸT NHÃN) --- */
    .zzz-subquest-item {
        position: relative;
        background: #fff;
        border: 2px solid #111 !important;
        transform: skewX(-5deg);
        margin: 15px 0 .5rem 15px; /* Tăng margin top lên để nhãn có chỗ hiện ra */
        overflow: visible; /* QUAN TRỌNG: Đổi thành visible để nhãn không bị cắt */
        transition: all .2s cubic-bezier(.25,.8,.25,1);
    }

        .zzz-subquest-item > * {
            transform: skewX(5deg);
        }

        .zzz-subquest-item::before {
            content: "OBJ_TRACKING";
            position: absolute;
            top: -12px; /* Đẩy cao lên một chút hẳn so với viền */
            left: 15px;
            background: #111;
            color: var(--zzz-primary,#D2FF00);
            font-size: .65rem;
            font-family: monospace;
            padding: 2px 8px; /* Thêm padding cho nhãn to rõ hơn */
            font-weight: bold;
            transform: skewX(5deg);
            opacity: 0;
            z-index: 10; /* Đảm bảo luôn nằm trên cùng */
            transition: all .2s;
            pointer-events: none;
        }

        /* Hiệu ứng khi Hover */
        .zzz-subquest-item:hover {
            border-left: 10px solid #111 !important;
            background: #f4f4f6 !important;
            transform: skewX(-5deg) translate(-2px,-2px); /* Giảm độ giật để không đè nhãn */
            box-shadow: 8px 8px 0 rgba(17,17,17,.15);
        }

            .zzz-subquest-item:hover::before {
                opacity: 1;
                top: -15px; /* Khi hover nhãn nhấc cao lên một xíu cho rõ */
            }

    /* LAYER */
    .zzz-layer-base {
        position: relative;
        z-index: 1;
    }

    .zzz-layer-overlay {
        position: absolute;
        inset: 0;
        background: var(--zzz-accent,#FF3366);
        z-index: 2;
        clip-path: inset(0 100% 0 0);
        transition: clip-path .8s cubic-bezier(.25,.8,.25,1);
    }

    .zzz-subquest-item:hover .zzz-layer-overlay {
        clip-path: inset(0 0 0 0);
    }

    /* BUTTON */
    .zzz-btn-launch {
        background: var(--zzz-black);
        color: var(--zzz-primary);
        border: 2px solid var(--zzz-primary) !important;
        transform: skewX(-15deg);
        box-shadow: 3px 3px 0 var(--zzz-primary,#D2FF00);
        transition: all .1s ease;
        text-decoration: none;
    }

        .zzz-btn-launch > * {
            display: inline-block;
            transform: skewX(15deg);
            font-weight: 900;
        }

        .zzz-btn-launch:hover {
            background: var(--zzz-primary,#D2FF00) !important;
            color: var(--zzz-black) !important;
            box-shadow: 5px 5px 0 var(--zzz-black);
            transform: skewX(-15deg) translate(-2px,-2px);
            border: 2px solid var(--zzz-black) !important;
        }

        .zzz-btn-launch:active {
            transform: skewX(-15deg) translate(4px,4px);
            box-shadow: none;
        }

    .zzz-btn-launch-inverted {
        background: #111;
        color: var(--zzz-primary,#D2FF00);
        border: 2px solid #111 !important;
        transform: skewX(-15deg);
        box-shadow: 3px 3px 0 var(--zzz-primary,#D2FF00);
        text-decoration: none;
    }

        .zzz-btn-launch-inverted > * {
            display: inline-block;
            transform: skewX(15deg);
            font-weight: 900;
        }

</style>

