@model ChiTietTaiKhoanVM

@{
    ViewData["Title"] = "Thông Tin Tài Khoản";
}

<div class="container-fluid p-0 zzz-container-dossier">

    <div class="border-dashed p-3 p-lg-4 mb-4 d-flex flex-column flex-lg-row justify-content-between align-items-center gap-3 zzz-command-panel border-dark border-3 bg-white">
        <h1 class="m-0 zzz-page-title fw-bold text-uppercase fs-3 fs-lg-2 text-center text-lg-start w-100 w-lg-auto border-start border-primary border-5 ps-3 text-nowrap" style="border-left-color: var(--zzz-primary) !important; letter-spacing: 1px;">
            TRÍCH XUẤT THÔNG TIN
        </h1>
        <div class="d-flex align-items-center gap-3 w-100 w-lg-auto justify-content-center justify-content-lg-end"></div>
    </div>

    <div class="row g-4 mb-4 align-items-stretch">

        <div class="col-lg-4 col-md-5">
            <div class="card border-dark border-3 rounded-0 zzz-id-card shadow-lg h-100 position-relative overflow-hidden">
                <div class="zzz-hazard-strip"></div>
                <div class="card-body p-4 d-flex flex-column align-items-center text-center mt-3">
                    <i class="fas fa-user-astronaut mb-3 zzz-avatar-icon"></i>
                    <h2 class="fw-bolder zzz-text-mono text-dark mb-0 border-bottom border-dark border-3 pb-2 w-100 zzz-avatar-name text-break fs-3 fs-md-2">
                        @Model.User.UserName
                    </h2>
                    <div class="small fw-bold zzz-text-mono mb-4 mt-2 zzz-sub-label">TÊN ĐĂNG NHẬP</div>
                    <span class="badge zzz-badge-verified fs-5 px-4 py-3 w-100 zzz-text-mono rounded-0 border-dark border-3 text-white bg-success shadow-sm">
                        <i class="fas fa-check-circle me-1"></i> ĐÃ XÁC THỰC
                    </span>
                    <div class="mt-auto w-100 pt-3 border-top border-dark border-3 text-start zzz-text-mono small mt-4 fw-bold text-dark">
                        <div class="zzz-sub-label">SYS.LOG // DẤU VẾT:</div>
                        <div><i class="fas fa-angle-right me-1"></i> ACCESS GRANTED</div>
                        <div class="text-break"><i class="fas fa-angle-right me-1"></i> REF: @Guid.NewGuid().ToString().Substring(0, 13).ToUpper()</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-8 col-md-7">
            <div class="card border-dark border-3 rounded-0 bg-white shadow-lg h-100 d-flex flex-column">
                <div class="bg-dark text-white border-bottom border-dark border-3 px-4 py-3 d-flex justify-content-between align-items-center">
                    <span class="zzz-text-mono fw-bold fs-5">>_ MÃ HỒ SƠ:</span>
                    <span class="zzz-text-mono fw-black text-warning fs-4 ms-2 text-truncate" style="letter-spacing: 2px;">
                        @Model.User.Id.Substring(0, 8).ToUpper()
                    </span>
                </div>
                <div class="card-body p-4 p-lg-5 d-flex flex-column h-100">

                    <div class="mb-5">
                        @if (Model.NhanVien != null)
                        {
                            <div class="row g-3 mb-4">
                                <div class="col-12 col-xl-5">
                                    <label class="zzz-label fw-bold text-muted small text-uppercase mb-1">>_ MÃ NHÂN VIÊN</label>
                                    <div class="border border-dark border-2 bg-white px-3 py-3 fw-bold zzz-text-mono fs-5 shadow-sm text-dark text-nowrap overflow-hidden">
                                        #@Model.NhanVien.MaNV
                                    </div>
                                </div>
                                <div class="col-12 col-xl-7">
                                    <label class="zzz-label fw-bold text-muted small text-uppercase mb-1">>_ TÊN NHÂN VIÊN</label>
                                    <div class="border border-dark border-2 bg-white px-3 py-3 fw-black text-danger zzz-text-mono fs-5 text-uppercase shadow-sm text-truncate">
                                        @Model.NhanVien.TenNV
                                    </div>
                                </div>
                            </div>
                        }
                        else if (Model.KhachHang != null)
                        {
                            <div class="row g-3 mb-4">
                                <div class="col-12 col-xl-5">
                                    <label class="zzz-label fw-bold text-muted small text-uppercase mb-1">>_ MÃ KHÁCH HÀNG</label>
                                    <div class="border border-dark border-2 bg-white px-3 py-3 fw-bold zzz-text-mono fs-5 shadow-sm text-danger text-nowrap overflow-hidden">
                                        #@Model.KhachHang.MaKh
                                    </div>
                                </div>
                                <div class="col-12 col-xl-7">
                                    <label class="zzz-label fw-bold text-muted small text-uppercase mb-1">>_ TÊN KHÁCH HÀNG</label>
                                    <div class="border border-dark border-2 bg-white px-3 py-3 fw-black text-dark zzz-text-mono fs-5 text-uppercase shadow-sm text-truncate">
                                        @Model.KhachHang.TenKh
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="p-4 border border-dark border-2 bg-white text-center shadow-sm mb-4">
                                <h5 class="fw-bold zzz-text-mono text-muted mb-0">>_ TÀI KHOẢN TRỐNG</h5>
                            </div>
                        }

                        <div class="row g-3 align-items-stretch">
                            <div class="col-12 col-xl-7">
                                <label class="zzz-label fw-bold text-muted small text-uppercase mb-1">>_ ĐỊA CHỈ EMAIL</label>

                                <div class="zzz-data-box bg-white fw-bold zzz-text-mono shadow-sm text-truncate" title="@Model.User.Email">
                                    @Model.User.Email
                                </div>
                            </div>

                            <div class="col-12 col-xl-5">
                                <label class="zzz-label fw-bold text-muted small text-uppercase mb-1">>_ TRẠNG THÁI</label>
                                <div class="h-100">
                                    @if (Model.User.LockoutEnd != null && Model.User.LockoutEnd > DateTimeOffset.Now)
                                    {
                                        <div class="zzz-data-box box-center bg-danger text-white fw-bold fw-black zzz-text-mono shadow-sm text-nowrap">
                                            <i class="zzz-status-x me-2">×</i> BỊ KHÓA
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="zzz-data-box box-center text-dark fw-bold fw-black zzz-text-mono shadow-sm text-nowrap w-100"
                                             style="background-color: var(--zzz-primary); box-shadow: 2px 2px 0px #000 !important;">
                                            <span class="text-dark zzz-blink-dot me-2">●</span> HOẠT ĐỘNG
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-auto">
                        <h5 class="fw-bold zzz-text-mono border-bottom border-dark border-3 pb-2 mb-3 fs-5 fs-md-4">
                            <i class="fas fa-terminal me-2"></i> BẢNG LỆNH THỰC THI
                        </h5>

                        <div class="row g-3 align-items-stretch mb-3">
                            <div class="col-12 col-md-4">
                                <a asp-action="EditTaiKhoan" asp-route-id="@Model.User.Id" class="btn btn-primary fw-bold border-dark border-3 rounded-0 px-2 py-3 zzz-btn-action w-100 h-100 d-flex align-items-center justify-content-center shadow-sm text-nowrap" style="font-size: 1rem; letter-spacing: 0.5px;">
                                    <i class="fas fa-pen me-2"></i> SỬA TT
                                </a>
                            </div>

                            <div class="col-12 col-md-4">
                                @if (Model.User.LockoutEnd != null && Model.User.LockoutEnd > DateTimeOffset.Now)
                                {
                                    <form asp-action="MoKhoaTaiKhoan" method="post" class="m-0 h-100">
                                        <input type="hidden" name="userId" value="@Model.User.Id" />
                                        <button type="submit" class="btn zzz-btn-tech text-dark fw-bold border-dark border-3 rounded-0 px-2 py-3 zzz-btn-action w-100 h-100 d-flex align-items-center justify-content-center shadow-sm text-nowrap" style="font-size: 1rem; letter-spacing: 0.5px;">
                                            <i class="fas fa-unlock me-2"></i> MỞ KHÓA
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="KhoaTaiKhoan" method="post" class="m-0 h-100">
                                        <input type="hidden" name="userId" value="@Model.User.Id" />
                                        <button type="submit" class="btn zzz-btn-tech fw-bold border-dark border-3 rounded-0 px-2 py-3 w-100 h-100 d-flex align-items-center justify-content-center shadow-sm text-nowrap" style="font-size: 1rem; letter-spacing: 0.5px;">
                                            <i class="fas fa-lock me-2"></i> KHÓA TK
                                        </button>
                                    </form>
                                }
                            </div>

                            <div class="col-12 col-md-4">
                                <form asp-action="XoaTaiKhoan" method="post" class="m-0 h-100" onsubmit="return confirm('SYS.WARN // CẢNH BÁO: Bạn có chắc chắn muốn XÓA VĨNH VIỄN tài khoản này?')">
                                    <input type="hidden" name="userId" value="@Model.User.Id" />
                                    <button type="submit" class="btn btn-danger zzz-btn-danger fw-bold border-dark border-3 rounded-0 px-2 py-3 zzz-btn-action w-100 h-100 d-flex align-items-center justify-content-center shadow-sm text-nowrap" style="font-size: 1rem; letter-spacing: 0.5px;">
                                        <i class="fas fa-skull me-2"></i> XÓA DATA
                                    </button>
                                </form>
                            </div>
                        </div>

                        <div class="w-100">
                            <a asp-action="QuanLyTaiKhoan" class="btn zzz-btn-cancel fw-bold fs-5 px-3 py-3 border-dark border-3 rounded-0 w-100 text-center shadow-sm d-flex justify-content-center align-items-center">
                                <i class="fas fa-undo me-2"></i> QUAY LẠI TRUNG TÂM QUẢN LÝ
                            </a>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/auto-alert.js"></script>
}