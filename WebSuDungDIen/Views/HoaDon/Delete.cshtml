@model WebSuDungDIen.Models.HoaDon

@{
    ViewData["Title"] = "Xóa Hóa Đơn";

    // Tà thuật tính toán Điện Tiêu Thụ từ ViewBag ngay trên View
    int dienTieuThu = 0;
    if (ViewBag.ChiSoMucTieu != null)
    {
        // Tự động lấy Số Mới trừ Số Cũ
        dienTieuThu = ViewBag.ChiSoMucTieu.ChiSoMoi - ViewBag.ChiSoMucTieu.ChiSoCu;
    }
}

<div class="container-fluid p-0" style="max-width: 800px; margin: 0 auto;">

    <div class="border border-danger border-4 bg-danger text-white p-4 mb-4 position-relative" style="box-shadow: 8px 8px 0px var(--zzz-black);">
        <h1 class="m-0 zzz-page-title border-start border-5 ps-3" style="border-left-color: var(--zzz-black) !important;">
            <i class="fas fa-exclamation-triangle"></i> CẢNH BÁO HỆ THỐNG
        </h1>
        <p class="m-0 zzz-text-mono mt-2 fw-bold" style="font-size: 1.1rem;">
            YÊU CẦU TIÊU HỦY BIÊN LAI HÓA ĐƠN. HÀNH ĐỘNG NÀY LÀ VĨNH VIỄN VÀ KHÔNG THỂ KHÔI PHỤC!
        </p>
    </div>

    <div class="card rounded-0 border-dark border-3 mb-4 bg-white" style="box-shadow: 8px 8px 0px var(--zzz-black);">
        <div class="card-header bg-dark text-white rounded-0 border-bottom border-dark border-3 p-3 d-flex justify-content-between align-items-center">
            <h4 class="m-0 zzz-text-mono text-white fw-bold">MÃ HÓA ĐƠN: #@Model.MaHd</h4>
            <span class="badge bg-danger border border-white zzz-text-mono fs-6">CHỜ XÓA</span>
        </div>

        <div class="card-body p-4">
            <div class="row g-4">

                <div class="col-md-12">
                    <label class="zzz-text-mono text-muted small fw-bold text-uppercase">Địa chỉ cung cấp điện</label>
                    <div class="zzz-text-mono fw-bold fs-6 text-dark border-bottom border-dark border-2 pb-2">
                        <i class="fas fa-map-marker-alt text-danger me-2"></i> @(ViewBag.KhachMucTieu?.DiaChiDayDu ?? "[CHƯA CẬP NHẬT ĐỊA CHỈ]")
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="zzz-text-mono text-muted small fw-bold text-uppercase">Mã Định Danh</label>
                    <div class="zzz-text-mono fw-bold fs-5 text-dark border-bottom border-dark border-2 pb-1">
                        <i class="fas fa-id-card text-muted me-2"></i> @(ViewBag.KhachMucTieu?.MaKh ?? "[VÔ DANH]")
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="zzz-text-mono text-muted small fw-bold text-uppercase">Tên Khách Hàng</label>
                    <div class="zzz-text-mono fw-bolder fs-5 text-primary border-bottom border-dark border-2 pb-1 text-truncate">
                        <i class="fas fa-user-tag text-primary me-2"></i> @(ViewBag.KhachMucTieu?.TenKh ?? "[VÔ DANH]")
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="zzz-text-mono text-muted small fw-bold text-uppercase">Tổng điện tiêu thụ</label>
                    <div class="zzz-text-mono fw-bolder fs-4 text-warning bg-dark border border-dark p-2 text-center shadow-sm">
                        <i class="fas fa-bolt text-warning me-2"></i> @dienTieuThu <span class="fs-6 text-light">kWh</span>
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="zzz-text-mono text-muted small fw-bold text-uppercase">Tổng tiền cần thu</label>
                    <div class="zzz-text-mono fw-bolder fs-4 text-white bg-danger border border-dark p-2 text-center shadow-sm">
                        <i class="fas fa-money-bill-wave text-white me-2"></i> @Model.TongThanhToan.ToString("N0") <span class="fs-6">VNĐ</span>
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="zzz-text-mono text-muted small fw-bold text-uppercase">Trạng thái thanh toán</label>
                    <div class="fw-bold fs-6 border p-2 bg-light border-dark">
                        @if (Model.TrangThai == "DaThanhToan" || Model.TrangThai == "Đã thanh toán")
                        {
                            <span class="text-success"><i class="fas fa-check-circle me-2"></i> ĐÃ THANH TOÁN</span>
                        }
                        else
                        {
                            <span class="text-danger"><i class="fas fa-hourglass-half me-2"></i> CHƯA THANH TOÁN</span>
                        }
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="zzz-text-mono text-muted small fw-bold text-uppercase">Ngày thanh toán</label>
                    <div class="fw-bold fs-6 border p-2 bg-light border-dark text-primary">
                        <i class="fas fa-calendar-check me-2"></i> @(Model.NgayThanhToan?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa ghi nhận")
                    </div>
                </div>

            </div>
        </div>
    </div>

    <div class="d-flex gap-3 mt-4">
        <form asp-action="Delete" class="w-50">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn w-100 btn-danger zzz-btn-danger fs-5 fw-bold py-3 rounded-0 border-dark border-3" style="box-shadow: 4px 4px 0px var(--zzz-black);">
                <i class="fas fa-skull me-2"></i> XÁC NHẬN TIÊU HỦY
            </button>
        </form>

        <a asp-action="Index" class="btn w-50 btn-light zzz-btn-cancel fs-5 fw-bold py-3 text-center d-flex justify-content-center align-items-center border-dark border-3 rounded-0" style="box-shadow: 4px 4px 0px var(--zzz-black);">
            <i class="fas fa-undo me-2"></i> RÚT LUI
        </a>
    </div>

</div>