@model WebSuDungDIen.Models.HoaDon

@{
    ViewData["Title"] = "Chi tiết Hóa Đơn";
    // Nhận dữ liệu từ Controller
    var chiSoCu = ViewBag.ChiSoCu != null ? (int)ViewBag.ChiSoCu : 0;
    var chiSoMoi = ViewBag.ChiSoMoi != null ? (int)ViewBag.ChiSoMoi : 0;
    var soDienTieuThu = Model.SoDienTieuThu;
    var bangGia = ViewBag.BangGia as List<WebSuDungDIen.Models.DonGiaDien>;
}

<div class="border-dashed p-3 mb-4 d-flex justify-content-between align-items-center flex-wrap gap-3 zzz-command-panel border-dark border-3 bg-white">

    <div class="d-flex align-items-center gap-2">
        <h1 class="m-0 zzz-page-title fw-bold text-uppercase fs-3 fs-md-2 border-start border-primary border-5 ps-3" style="border-left-color: var(--zzz-primary) !important;">
            [ BẢN GHI ] CHI TIẾT HÓA ĐƠN
        </h1>
        <span class="badge border border-dark zzz-text-mono fs-6 shadow-sm">
            #@Model.MaHd
        </span>
    </div>

    <div class="d-flex align-items-center justify-content-center">
        @if (Model.TrangThai == "DaThanhToan")
        {
            <span class="zzz-sys-status text-success fw-bold border border-success border-2 px-4 py-2 bg-light text-center shadow-sm fs-5 text-nowrap">
                <i class="bi bi-check-circle-fill me-1"></i> ĐÃ THANH TOÁN
            </span>
        }
        else
        {
            <span class="zzz-sys-status text-danger fw-bold border border-danger border-2 px-4 py-2 bg-light text-center shadow-sm fs-5 text-nowrap">
                <i class="bi bi-exclamation-circle-fill me-1"></i>
                <span class="zzz-blink-dot zzz-text-yellow"></span> CHƯA THANH TOÁN
            </span>
        }
    </div>

</div>

<div class="row d-flex flex-column flex-md-row">

    <div class="col-md-5 order-2 order-md-1 mt-4 mt-md-0">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-light fw-bold">
                <i class="bi bi-info-square me-2"></i> THÔNG TIN CHUNG
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5">Mã hóa đơn</dt>
                    <dd class="col-sm-7 fw-bold text-primary">@Model.MaHd</dd>

                    <dt class="col-sm-5">Khách hàng</dt>
                    <dd class="col-sm-7">@ViewBag.ThongTinKhach</dd>

                    <dt class="col-sm-5">Nhân viên lập</dt>
                    <dd class="col-sm-7">@ViewBag.ThongTinNhanVien</dd>

                    <dt class="col-sm-5">Ngày lập HĐ</dt>
                    <dd class="col-sm-7">
                        @(((DateTime)ViewBag.NgayLap).ToString("dd/MM/yyyy HH:mm"))
                    </dd>

                    <dt class="col-sm-5 d-flex align-items-center">Ngày thanh toán</dt>
                    <dd class="col-sm-7 mb-0 d-flex align-items-center">
                        @if (Model.TrangThai == "DaThanhToan")
                        {
                            <span class="text-success fw-bold d-inline-flex align-items-center gap-2">
                                <i class="bi bi-calendar-check fs-5"></i>
                                <span>@(Model.NgayThanhToan?.ToString("dd/MM/yyyy HH:mm") ?? "Đang cập nhật...")</span>
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger d-inline-flex align-items-center">
                                <i class="bi bi-x-circle me-1"></i> Chưa thanh toán
                            </span>
                        }
                    </dd>
                </dl>
            </div>
        </div>

        <div class="card shadow-sm border-info">
            <div class="card-header bg-info text-white fw-bold">
                <i class="bi bi-speedometer2 me-2"></i> CHỈ SỐ TIÊU THỤ
            </div>
            <div class="card-body text-center">
                <div class="d-flex justify-content-around align-items-center mb-2">
                    <div>
                        <small class="text-muted d-block">Chỉ số cũ</small>
                        <span class="fs-4 fw-bold">@chiSoCu</span>
                    </div>
                    <div><i class="bi bi-arrow-right fs-4 text-muted"></i></div>
                    <div>
                        <small class="text-muted d-block">Chỉ số mới</small>
                        <span class="fs-4 fw-bold text-primary">@chiSoMoi</span>
                    </div>
                </div>
                <hr />
                <h5 class="mb-0">Tổng tiêu thụ: <span class="text-danger fs-3 fw-bold">@soDienTieuThu</span> kWh</h5>
            </div>
        </div>

        <div class="d-grid gap-3 d-md-flex flex-md-column flex-xl-row mt-4 pt-4 border-top border-dark border-3">
            <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary fw-bold rounded-0 px-4 py-3 zzz-btn-action w-100 w-md-auto text-center shadow-sm">
                <i class="bi bi-pencil-square me-2"></i> CẬP NHẬT BIÊN LAI
            </a>

            <a asp-action="Index" class="btn btn-dark zzz-btn-cancel fw-bold border-dark border-3 rounded-0 px-4 py-3 zzz-btn-action w-100 w-md-auto text-center ms-xl-auto shadow-sm text-white">
                <i class="bi bi-arrow-left me-2"></i> QUAY VỀ
            </a>
        </div>
    </div>

    <div class="col-md-7 order-1 order-md-2">
        <div class="card shadow-sm">
            <div class="card-header bg-light fw-bold">
                <i class="bi bi-receipt me-2"></i> CHI TIẾT TÍNH TIỀN ĐIỆN
            </div>

            <div class="card-body p-0 table-responsive">
                <table class="table table-bordered table-striped mb-0 text-nowrap">
                    <thead class="table-dark text-center">
                        <tr>
                            <th>Bậc</th>
                            <th>Số lượng (kWh)</th>
                            <th>Đơn giá (đ)</th>
                            <th>Thành tiền (đ)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            // Logic phân tách số chữ điện ra các bậc để hiển thị
                            int conLai = soDienTieuThu;
                            int[] muc = { 50, 50, 100, 100, 100 }; // Bậc 1-5

                            if (bangGia != null && bangGia.Count >= 6)
                            {
                                for (int i = 0; i < muc.Length; i++)
                                {
                                    if (conLai <= 0) break;
                                    int soDienBacNay = Math.Min(conLai, muc[i]);
                                    decimal tienBacNay = soDienBacNay * bangGia[i].Gia;
                                    conLai -= soDienBacNay;

                                    <tr>
                                        <td class="text-center">Bậc @(i + 1)</td>
                                        <td class="text-center text-primary fw-bold">@soDienBacNay</td>
                                        <td class="text-end">@bangGia[i].Gia.ToString("N0")</td>
                                        <td class="text-end fw-bold">@tienBacNay.ToString("N0")</td>
                                    </tr>
                                }

                                // Bậc 6 (Phần dư còn lại)
                                if (conLai > 0)
                                {
                                    decimal tienBac6 = conLai * bangGia[5].Gia;
                                    <tr>
                                        <td class="text-center text-danger fw-bold">Bậc 6</td>
                                        <td class="text-center text-danger fw-bold">@conLai</td>
                                        <td class="text-end">@bangGia[5].Gia.ToString("N0")</td>
                                        <td class="text-end text-danger fw-bold">@tienBac6.ToString("N0")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-danger">Chưa có dữ liệu bảng giá!</td>
                                </tr>
                            }
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <td colspan="3" class="text-end fw-bold">Cộng tiền điện:</td>
                            <td class="text-end fw-bold">@Model.TienDien.ToString("N0") đ</td>
                        </tr>
                        <tr>
                            <td colspan="3" class="text-end fw-bold">Thuế VAT (@Model.PhanTramVAT%):</td>
                            <td class="text-end fw-bold">@Model.ThueVAT.ToString("N0") đ</td>
                        </tr>
                        <tr class="table-warning">
                            <td colspan="3" class="text-end fw-bold fs-5 text-danger">TỔNG CỘNG TIỀN THANH TOÁN:</td>
                            <td class="text-end fw-bold fs-5 text-danger">@Model.TongThanhToan.ToString("N0") đ</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>