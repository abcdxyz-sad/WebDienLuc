
@model WebSuDungDIen.ViewModels.LapHoaDonTheoPhuongVM

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>HoaDon</h4>
<hr />
<div class="row">

    <!-- FORM BÊN TRÁI -->
    <div class="col-md-6">
        <input type="hidden" id="maMien" name="MaMien" />
        <input type="hidden" id="diaChiDayDu" name="DiaChiDayDu" />
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label>Phường/Xã</label>
                <select asp-for="MaPhuongApi" class="form-control" id="phuongSelect" asp-items="@ViewBag.DanhSachPhuong">
                    <option value="">-- Chọn phường/xã --</option>
                </select>
            </div>

            <hr />

            <h5>Danh sách khách thuộc phường</h5>
            <ul id="khachList"></ul>    

            <p>
                <a class="btn btn-outline-primary"
                   data-bs-toggle="collapse"
                   href="#giaContainer"
                   role="button">
                    Cấu hình đơn giá
                </a>
            </p>

            <div class="collapse" id="giaContainer">
                <div class="card card-body">
                    @for (int i = 0; i < Model.DanhSachGia.Count; i++)
                    {
                        <div class="mb-2">
                            <label>Bậc @Model.DanhSachGia[i].Bac</label>
                            <input asp-for="DanhSachGia[i].Gia"
                                   class="form-control gia-input"
                                   placeholder="Nhập đơn giá..." />
                            <input type="hidden" asp-for="DanhSachGia[i].Bac" />
                        </div>
                    }
                </div>
            </div>

            <div class="form-group mt-3">
                <label>% Thuế VAT</label>
                <input asp-for="PhanTramVAT"
                       type="number"
                       step="0.1"
                       class="form-control"
                       id="vatInput"
                       placeholder="Ví dụ: 10" />
            </div>

            <br />
            <input type="submit" value="Create" class="btn btn-primary" />
        </form>
    </div>

    <!-- DEBUG BÊN PHẢI -->
    <div class="col-md-6">
        <div style="border-left:2px dashed gray; padding-left:20px;">
            <h4>⚡ Debug tính tiền</h4>

            <div class="form-group">
                <label>Nhập chỉ số điện test</label>
                <input type="number" id="debugInput" class="form-control" />
            </div>

            <br />

            <div id="debugResult" style="background:#f8f9fa; padding:15px; min-height:150px;">
                Kết quả sẽ hiện ở đây...
            </div>
        </div>
    </div>

</div>


<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Lấy các element
            const debugInput = document.getElementById("debugInput");
            const vatInput = document.getElementById("vatInput");
            const debugResult = document.getElementById("debugResult");
            const phuongSelect = document.getElementById("phuongSelect");
            const khachList = document.getElementById("khachList");

            // Gắn sự kiện tính tiền
            if (debugInput) debugInput.addEventListener("input", tinhTien);
            if (vatInput) vatInput.addEventListener("input", tinhTien);

            // Mảng quy định số kWh mỗi bậc (Chuẩn EVN 6 bậc)
            // Bậc 1: 50, Bậc 2: 50, Bậc 3: 100, Bậc 4: 100, Bậc 5: 100
            const muc = [50, 50, 100, 100, 100];

            function tinhTien() {
                const soDien = parseInt(debugInput.value);
                const vat = parseFloat(vatInput.value) || 0;

                if (!soDien || soDien <= 0) {
                    debugResult.innerHTML = "Kết quả sẽ hiện ở đây...";
                    return;
                }

                const giaInputs = document.querySelectorAll(".gia-input");
                const gia = Array.from(giaInputs).map(x => parseFloat(x.value) || 0);

                // Kiểm tra xem có đủ 6 ô nhập giá không
                if (gia.length < 6) {
                    debugResult.innerHTML = "<span class='text-danger'>Lỗi: Không tìm thấy đủ 6 ô nhập đơn giá (Bậc 1 đến Bậc 6). Vui lòng kiểm tra lại dữ liệu.</span>";
                    return;
                }

                let conLai = soDien;
                let tong = 0;
                let html = "<ul class='list-unstyled mb-2'>";

                for (let i = 0; i < muc.length; i++) {
                    if (conLai <= 0) break;

                    let x = Math.min(conLai, muc[i]);
                    let tien = x * gia[i];
                    tong += tien;

                    html += `<li>Bậc ${i + 1}: ${x} kWh × ${gia[i].toLocaleString()} = <b>${tien.toLocaleString()} đ</b></li>`;
                    conLai -= x;
                }

                // Tính Bậc 6 (Phần dư còn lại)
                if (conLai > 0) {
                    let tien = conLai * gia[5];
                    tong += tien;
                    html += `<li class="text-danger">Bậc 6: ${conLai} kWh × ${gia[5].toLocaleString()} = <b>${tien.toLocaleString()} đ</b></li>`;
                }

                let tienThue = tong * (vat / 100);
                let tongThanhToan = tong + tienThue;

                html += `</ul>`;
                html += `<hr>`;
                html += `<p>Tiền điện: <b>${tong.toLocaleString()} đ</b></p>`;
                html += `<p>Thuế (${vat}%): <b>${tienThue.toLocaleString()} đ</b></p>`;
                html += `<h5 class="text-success">Tổng thanh toán: ${tongThanhToan.toLocaleString()} đ</h5>`;

                debugResult.innerHTML = html;
            }

            // Gắn sự kiện chọn phường
            if (phuongSelect) {
                phuongSelect.addEventListener("change", async function () {
                    const phuongId = this.value;
                    khachList.innerHTML = "";

                    if (!phuongId) return;

                    try {
                        const response = await fetch(`/HoaDon/GetKhachByPhuong?maPhuongApi=${phuongId}`);
                        if (!response.ok) throw new Error("Lỗi mạng");

                        const data = await response.json();

                        if (data.length === 0) {
                            khachList.innerHTML = "<li>Không có khách trong phường này</li>";
                            return;
                        }

                        data.forEach(kh => {
                            let hienThiChiSo = kh.chiSo !== null
                                ? `<span class="text-primary">${kh.chiSo} kWh</span>`
                                : `<span class="text-danger">Chưa nhập chỉ số</span>`;

                            khachList.innerHTML += `
                                <li>
                                    <b>${kh.ten}</b>
                                    - Số điện: ${hienThiChiSo}
                                </li>
                            `;
                        });
                    } catch (error) {
                        khachList.innerHTML = "<li class='text-danger'>Lỗi khi tải danh sách khách.</li>";
                        console.error("Fetch error:", error);
                    }
                });
            }
        });
    </script>
}
