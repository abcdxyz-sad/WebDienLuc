@model IEnumerable<WebSuDungDIen.ViewModels.HoaDonIndexVM>

@{
    ViewData["Title"] = "Quản lý Hóa Đơn";
    var now = DateTime.Now;
}

<div class="border-dashed p-3 p-lg-4 mb-4 d-flex flex-column flex-lg-row justify-content-between align-items-center gap-3 zzz-command-panel border-dark border-3 bg-white">
    <div class="d-inline-block text-nowrap bg-transparent pe-5 py-2 zzz-title-wrap" data-intro="Chào mừng đến với khu vực hóa đơn!" data-step="1">
        <h1 class="m-0 zzz-page-title fw-bold text-uppercase fs-3 fs-lg-2 text-center text-lg-start w-100 w-lg-auto border-start border-primary border-5 ps-3 text-nowrap" style="border-left-color: var(--zzz-primary) !important; letter-spacing: 1px;">
            [ TỆP DỮ LIỆU ] HÓA ĐƠN
        </h1>
    </div>
    <div class="d-flex align-items-center gap-3 w-100 w-lg-auto justify-content-center justify-content-lg-end">
        <div class="d-inline-block shadow-sm"
             data-intro="Bấm vào nút này để lập hóa đơn cho khách theo phường!"
             data-step="2">
            <a asp-action="Create"
               class="btn btn-primary fw-bold border-dark border-2 rounded-0 px-4 py-2 zzz-text-mono text-nowrap d-inline-flex align-items-center">
                <i class="bi bi-plus-square-fill me-2"></i> PHÁT HÀNH HÓA ĐƠN
            </a>
        </div>
    </div>
</div>

<div class="card mb-4 border-dark border-2 rounded-0 shadow-sm zzz-intro-fix" data-intro="Đây bạn có thể lọc các thông tin theo các tiêu chí và tìm kiếm thông tin" data-step="3">
    <div class="card-header bg-dark text-white border-dark border-bottom border-2 rounded-0 zzz-text-mono fw-bold">
        <i class="bi bi-sliders me-2 text-warning"></i>BỘ LỌC TÌM KIẾM
    </div>
    <div class="card-body p-3 p-md-4">
        <form asp-action="Index" method="get" class="row g-2 align-items-end">

            <div class="col-md-5">
                <div class="row g-2">
                    <div class="col-6">
                        <label class="form-label fw-bold" style="font-size: 0.85rem;">Tỉnh / Thành phố</label>
                        <select name="maTinh" id="selectTinh" class="form-select fw-bold border-dark border-2 text-truncate" onchange="this.form.submit();">
                            <option value="">-- Tất cả Tỉnh --</option>
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="form-label fw-bold" style="font-size: 0.85rem;">Phường / Xã</label>
                        <select name="maPhuongApi" id="ward" class="form-select fw-bold border-dark border-2 text-truncate" onchange="this.form.submit();">
                            <option value="">-- Chọn Phường --</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="row g-2">
                    <div class="col-6">
                        <label class="form-label fw-bold" style="font-size: 0.85rem;">Tháng</label>
                        <select name="thang" class="form-select fw-bold border-dark border-2 px-1" asp-items="ViewBag.ThangList" onchange="this.form.submit();">
                            <option value="">&nbsp;&nbsp;-- ALL</option>
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="form-label fw-bold" style="font-size: 0.85rem;">Năm</label>
                        <select name="nam" class="form-select fw-bold border-dark border-2 px-1" asp-items="ViewBag.NamList" onchange="this.form.submit();">
                            <option value="">&nbsp;&nbsp;-- ALL</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="col-md-2 mt-3 mt-md-0">
                <div class="d-flex gap-2 h-100">
                    <button type="submit" class="btn btn-primary flex-fill fw-bold border-dark border-2 rounded-0 shadow-sm">
                        <i class="bi bi-search"></i> LỌC
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary fw-bold border-dark border-2 rounded-0 shadow-sm" title="Reset">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </div>

            <div class="col-md-2 mt-3 mt-md-0">
                <div class="border-dashed p-2 text-center bg-light border-dark border-2 h-100 d-flex flex-column justify-content-center">
                    <small class="text-muted text-uppercase fw-bold d-block" style="font-size: 0.7rem;">Tổng số lượng</small>
                    <strong class="fs-4 text-primary" style="line-height: 1;">@((Model != null) ? Model.Count().ToString("00") : "00")</strong>
                </div>
            </div>

        </form>
    </div>
</div>

<div class="zzz-data-toolbar d-flex flex-wrap justify-content-between align-items-center gap-3 p-3 bg-white border-dark border-2 mb-4" style="box-shadow: 4px 4px 0px rgba(0,0,0,0.1);"
     data-intro="Đây bạn có thể nhập hoặc xuất dữ liệu bằng excel" data-step="4">

    <div class="d-flex flex-wrap align-items-center gap-3 flex-grow-1 flex-lg-grow-0">
        <div class="bg-dark text-white px-3 py-2 fw-bold zzz-text-mono border-dark border-2 shadow-sm text-nowrap">
            <i class="bi bi-database-fill text-success me-2"></i> [ DATA_SYNC ]
        </div>

        <form asp-action="ResetAllTrangThai" method="post" class="m-0 flex-grow-1 flex-sm-grow-0" onsubmit="return confirm('⚠️ CẢNH BÁO: Đưa TOÀN BỘ hóa đơn về trạng thái CHƯA THANH TOÁN. Xác nhận?');">
            <button type="submit" class="btn btn-outline-secondary w-100 fw-bold zzz-text-mono px-3 border-dark border-2 rounded-0 shadow-sm text-nowrap" title="Reset toàn bộ trạng thái thanh toán">
                <i class="bi bi-rewind-fill me-1"></i> [DEBUG] RESET
            </button>
        </form>
    </div>

    <div class="d-flex flex-wrap align-items-center gap-3 flex-grow-1 flex-lg-grow-0 justify-content-lg-end">

        <form asp-action="ImportFromExcel" method="post" enctype="multipart/form-data" class="m-0 flex-grow-1 flex-sm-grow-0">
            <div class="input-group shadow-sm">
                <input type="file" name="file" class="form-control border-dark border-2 rounded-0 fw-bold text-muted" style="min-width: 230px;" accept=".xlsx, .xls" required />
                <button type="submit" class="btn btn-success fw-bold zzz-text-mono px-3 border-dark border-2 rounded-0">
                    <i class="bi bi-cloud-arrow-up-fill me-1"></i> NẠP
                </button>
            </div>
        </form>

        <div class="vr bg-dark opacity-50 d-none d-md-block" style="width: 2px; min-height: 38px;"></div>

        <a asp-action="ExportMongoFormatToExcel" class="btn btn-primary fw-bold zzz-text-mono px-3 py-2 border-dark border-2 rounded-0 shadow-sm text-center text-nowrap flex-grow-1 flex-sm-grow-0">
            <i class="bi bi-file-earmark-excel-fill me-1"></i> XUẤT [XLSX]
        </a>

    </div>
</div>

<div class="container-fluid px-0 mt-4" data-intro="Đây hiển thị thông tin hóa đơn của các khách hàng đã lập hóa đơn" data-step="5">
    @if (Model != null && Model.Any())
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 position-relative border-dark border-2 rounded-0" style="box-shadow: 4px 4px 0px rgba(0,0,0,0.05);">

                        @if (item.Thang == now.Month && item.Nam == now.Year)
                        {
                            <span class="position-absolute top-0 start-100 translate-middle badge bg-warning text-dark border border-dark border-2 shadow-sm" style="z-index: 10; transform: rotate(15deg) !important;">
                                NEW
                            </span>
                        }

                        <div class="card-header d-flex justify-content-between align-items-center bg-white border-bottom-0 pt-3">
                            <span class="badge bg-secondary border border-dark">#@item.MaHd</span>

                            @if (item.TrangThai)
                            {
                                <span class="badge bg-success border border-dark shadow-sm">
                                    <i class="bi bi-check-lg me-1"></i>ĐÃ THU
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger animate__animated animate__flash animate__slow animate__infinite border border-dark shadow-sm">
                                    <i class="bi bi-exclamation-triangle-fill me-1"></i>CHƯA THU
                                </span>
                            }
                        </div>

                        <div class="card-body">
                            <h5 class="card-title fw-bold mb-3 text-uppercase text-truncate" style="font-family: 'Orbitron', sans-serif;" title="@item.TenKhachHang">
                                @item.TenKhachHang
                            </h5>

                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <div class="p-2 border-dashed bg-light h-100">
                                        <small class="text-muted d-block text-uppercase" style="font-size: 0.7rem;">Kỳ hóa đơn</small>
                                        <span class="fw-bold">T.@item.Thang / @item.Nam</span>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="p-2 border-dashed bg-light h-100">
                                        <small class="text-muted d-block text-uppercase" style="font-size: 0.7rem;">Tiêu thụ</small>
                                        <span class="fw-bold text-danger">@item.SoDienTieuThu <small class="text-muted">kWh</small></span>
                                    </div>
                                </div>
                            </div>

                            <div class="text-center mt-3 pt-3 border-top border-2 border-dark">
                                <small class="text-uppercase fw-bolder text-muted" style="letter-spacing: 1px;">Thanh toán</small>
                                <h2 class="text-danger fw-black mb-0 text-truncate" style="font-family: 'Orbitron', sans-serif;">
                                    @item.TongThanhToan.ToString("N0")<span class="fs-6 text-dark ms-1">đ</span>
                                </h2>
                            </div>
                        </div>

                        <div class="card-footer bg-white border-top-0 d-flex justify-content-between align-items-center pb-3">
                            <small class="fw-bold" style="font-size: 0.75rem;">
                                @if (item.TrangThai)
                                {
                                    <span class="text-success"><i class="bi bi-clock-history"></i> @(item.NgayThanhToan?.ToString("dd/MM/yyyy"))</span>
                                }
                                else
                                {
                                    <span class="text-warning text-dark"><i class="bi bi-hourglass-split"></i> CHỜ XỬ LÝ</span>
                                }
                            </small>

                            <div class="dropdown">
                                <button class="btn btn-sm btn-dark dropdown-toggle fw-bold rounded-0" type="button" data-bs-toggle="dropdown" data-bs-boundary="window">
                                    MENU
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end border-dark border-2 rounded-0 shadow" data-intro="Đây chứa các chức năng cơ bản cho quản lý hóa đơn" data-step="6">
                                    <li><a class="dropdown-item fw-bold" asp-action="Details" asp-route-id="@item.Id"><i class="bi bi-info-square me-2 text-primary"></i>Chi tiết</a></li>
                                    <li>
                                        <a class="dropdown-item fw-bold zzz-text-mono text-success" asp-action="PrintInvoice" asp-route-maHd="@item.MaHd" target="_blank">
                                            <i class="bi bi-printer-fill me-2"></i> IN BẢN SAO
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider border-dark"></li>
                                    <li><a class="dropdown-item fw-bold text-danger" asp-action="Delete" asp-route-id="@item.Id"><i class="bi bi-trash3 me-2"></i>Xóa hóa đơn</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5 border-dashed m-3 m-md-5 bg-white border-dark border-2" style="box-shadow: 4px 4px 0px rgba(0,0,0,0.1);">
            <i class="bi bi-inbox text-muted mb-3" style="font-size: 3rem;"></i>
            <h4 class="fw-bold text-danger zzz-text-mono">KHÔNG CÓ DỮ LIỆU</h4>
            <p class="text-muted fw-bold mb-0">Hệ thống chưa ghi nhận hóa đơn nào khớp với bộ lọc.</p>
        </div>
    }
</div>

@section Scripts {
    <script>
        // Lấy dữ liệu C# truyền sang
        const currentTinh = '@Html.Raw(ViewBag.CurrentTinh ?? "")';
        const currentPhuong = '@Html.Raw(ViewBag.CurrentPhuong ?? "")';
        
        // Mảng Tỉnh/Thành đã có hóa đơn (Móc trực tiếp từ DB)
        const tinhCoDataRaw = @Html.Raw(Json.Serialize(ViewBag.DanhSachTinhCoData ?? new List<string>()));

        const selectTinh = document.getElementById('selectTinh');
        const selectWard = document.getElementById('ward');

        function initDropdowns() {
            // ========================================================
            // 1. ĐỔ DỮ LIỆU TỈNH (Chỉ in ra các Tỉnh đang có trong DB)
            // ========================================================
            let htmlP = '<option value="">-- Tất cả Tỉnh/Thành --</option>';
            tinhCoDataRaw.forEach(tinh => {
                let isSelected = (tinh === currentTinh) ? "selected" : "";
                htmlP += `<option value="${tinh}" ${isSelected}>${tinh}</option>`;
            });
            selectTinh.innerHTML = htmlP;

            // ========================================================
            // 2. NẾU ĐÃ CHỌN TỈNH -> GỌI API NỘI BỘ LẤY PHƯỜNG
            // ========================================================
            if (currentTinh) {
                selectWard.innerHTML = '<option value="">-- Đang tải Phường... --</option>';
                
                // Vay mượn thẳng hàm GetPhuongByTinh bên ChiSoDienController của sếp!
                fetch(`@Url.Action("GetPhuongByTinh", "ChiSoDien")?maTinh=${encodeURIComponent(currentTinh)}`)
                    .then(res => res.json())
                    .then(data => {
                        selectWard.innerHTML = '<option value="">-- Chọn Phường --</option>';
                        data.forEach(item => {
                            let isSelected = (String(item.value) === String(currentPhuong)) ? "selected" : "";
                            // Thêm option vào dropdown Phường
                            selectWard.insertAdjacentHTML('beforeend', `<option value="${item.value}" ${isSelected}>${item.text}</option>`);
                        });
                    })
                    .catch(err => {
                        console.error("Lỗi móc dữ liệu Phường từ DB:", err);
                        selectWard.innerHTML = '<option value="">(Lỗi tải dữ liệu)</option>';
                    });
            } else {
                selectWard.innerHTML = '<option value="">-- Chọn Tỉnh trước --</option>';
            }
        }

        // Chạy hàm khi trang vừa load xong
        document.addEventListener("DOMContentLoaded", initDropdowns);

        // LƯU Ý: Không cần addEventListener('change') để submit form
        // Vì trong HTML thẻ <select> của sếp đã có sẵn onchange="this.form.submit();" rồi!
    </script>
}

