@model IEnumerable<WebSuDungDIen.ViewModels.HoaDonIndexVM>

@{
    ViewData["Title"] = "Quản lý Hóa Đơn";
    var now = DateTime.Now;
}
@if (TempData["ThongBao"] != null)
{
    <div id="thongBao" class="zzz-notification">
        <div class="zzz-content">
            <span class="zzz-icon">👾</span> <span class="zzz-text">@TempData["ThongBao"]</span>
        </div>
        <div class="zzz-decor-line"></div>
    </div>
}
@if (TempData["Error"] != null)
{
    <div id="thongBao" class="zzz-notification">
        <div class="zzz-content">
            <span class="zzz-icon">👾</span> <span class="zzz-text">@TempData["Error"]</span>
        </div>
        <div class="zzz-decor-line"></div>
    </div>
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Danh sách Hóa đơn</h1>
    <div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-square-fill"></i> PHÁT HÀNH HÓA ĐƠN
        </a>
    </div>
</div>

<div class="card mb-5">
    <div class="card-header">
        <i class="bi bi-sliders me-2"></i>BỘ LỌC TÌM KIẾM
    </div>
    <div class="card-body p-4">
        <form asp-action="Index" method="get" class="row g-3 align-items-end">

            <div class="col-md-4">
                <label class="form-label fw-bold" style="font-size: 0.85rem;">Khu vực (Đã có Hóa đơn)</label>

                <select name="maPhuongApi" class="form-select fw-bold border-dark border-2 text-truncate" style="padding-right: 2.5rem;" asp-items="ViewBag.PhuongList">
                    <option value="">-- Tất cả khu vực --</option>
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label fw-bold" style="font-size: 0.85rem;">Tháng</label>
                <select name="thang" class="form-select fw-bold border-dark border-2" asp-items="ViewBag.ThangList">
                    <option value="">-- ALL --</option>
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label fw-bold" style="font-size: 0.85rem;">Năm</label>
                <select name="nam" class="form-select fw-bold border-dark border-2" asp-items="ViewBag.NamList">
                    <option value="">-- ALL --</option>
                </select>
            </div>

            <div class="col-md-2">
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-search"></i> LỌC
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary" title="Reset">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </div>

            <div class="col-md-2">
                <div class="border-dashed p-2 text-center bg-white rounded">
                    <small class="text-muted text-uppercase fw-bold d-block" style="font-size: 0.7rem;">Tổng số lượng</small>
                    <strong class="fs-4 text-primary">@((Model != null) ? Model.Count().ToString("00") : "00")</strong>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="zzz-data-toolbar d-flex flex-column flex-xl-row justify-content-between align-items-center flex-wrap gap-3 p-3 bg-white border-dark border-2 mb-4" style="box-shadow: 4px 4px 0px rgba(0,0,0,0.1);">

    <div class="d-flex align-items-center gap-3 flex-wrap">
        <div class="bg-dark text-white px-3 py-2 fw-bold zzz-text-mono border-dark border-2 d-flex align-items-center shadow-sm">
            <i class="bi bi-database-fill text-success me-2"></i> [ DATA_SYNC ]
        </div>

        <form asp-action="ResetAllTrangThai" method="post" class="m-0" onsubmit="return confirm('⚠️ CẢNH BÁO: Đưa TOÀN BỘ hóa đơn về trạng thái CHƯA THANH TOÁN. Xác nhận?');">
            <button type="submit" class="btn btn-outline-secondary fw-bold zzz-text-mono px-3 border-dark border-2 rounded-0" title="Reset toàn bộ trạng thái thanh toán">
                <i class="bi bi-rewind-fill me-1"></i> [DEBUG] RESET
            </button>
        </form>
    </div>

    <div class="d-flex align-items-center gap-3 flex-wrap">

        <form asp-action="ImportFromExcel" method="post" enctype="multipart/form-data" class="d-flex align-items-center m-0 gap-2">
            <div class="input-group shadow-sm">
                <input type="file" name="file" class="form-control border-dark border-2 rounded-0 fw-bold text-muted" style="max-width: 250px;" accept=".xlsx, .xls" required />
                <button type="submit" class="btn btn-outline-secondary fw-bold zzz-text-mono px-3 border-dark border-2 rounded-0">
                    <i class="bi bi-cloud-arrow-up-fill me-1"></i> NẠP DATA
                </button>
            </div>
        </form>

        <div class="vr bg-dark opacity-50 d-none d-md-block" style="width: 2px;"></div>

        <a asp-action="ExportMongoFormatToExcel" class="btn btn-primary fw-bold zzz-text-mono px-3 py-2 border-dark border-2 rounded-0 shadow-sm">
            <i class="bi bi-file-earmark-excel-fill me-1"></i> XUẤT TỔNG HỢP [XLSX]
        </a>

    </div>
</div>

<div class="container-fluid px-0 mt-4">
    @if (Model != null && Model.Any())
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 position-relative">

                        @if (item.Thang == now.Month && item.Nam == now.Year)
                        {
                            <span class="position-absolute top-0 start-100 translate-middle badge bg-warning text-dark border border-dark" style="z-index: 10; transform: rotate(15deg) !important;">
                                NEW
                            </span>
                        }

                        <div class="card-header d-flex justify-content-between align-items-center bg-white border-bottom-0 pt-3">
                            <span class="badge bg-secondary">#@item.MaHd</span>

                            @if (item.TrangThai)
                            {
                                <span class="badge bg-success">
                                    <i class="bi bi-check-lg me-1"></i>ĐÃ THU
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger animate__animated animate__flash animate__slow animate__infinite">
                                    <i class="bi bi-exclamation-triangle-fill me-1"></i>CHƯA THU
                                </span>
                            }
                        </div>

                        <div class="card-body">
                            <h5 class="card-title fw-bold mb-3 text-truncate text-uppercase" style="font-family: 'Orbitron', sans-serif;">
                                @item.TenKhachHang
                            </h5>

                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <div class="p-2 border-dashed">
                                        <small class="text-muted d-block text-uppercase" style="font-size: 0.7rem;">Kỳ hóa đơn</small>
                                        <span class="fw-bold">T.@item.Thang / @item.Nam</span>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="p-2 border-dashed">
                                        <small class="text-muted d-block text-uppercase" style="font-size: 0.7rem;">Tiêu thụ</small>
                                        <span class="fw-bold">@item.SoDienTieuThu <small>kWh</small></span>
                                    </div>
                                </div>
                            </div>

                            <div class="text-center mt-3 pt-3 border-top border-2 border-dark">
                                <small class="text-uppercase fw-bolder text-muted" style="letter-spacing: 1px;">Thanh toán</small>
                                <h2 class="text-danger fw-black mb-0" style="font-family: 'Orbitron', sans-serif;">
                                    @item.TongThanhToan.ToString("N0")<span class="fs-6 text-dark ms-1">đ</span>
                                </h2>
                            </div>
                        </div>

                        <div class="card-footer d-flex justify-content-between align-items-center">
                            <small class="fw-bold" style="font-size: 0.75rem;">
                                @if (item.TrangThai)
                                {
                                    <span class="text-success"><i class="bi bi-clock-history"></i> @(item.NgayThanhToan?.ToString("dd/MM/yyyy"))</span>
                                }
                                else
                                {
                                    <span class="text-warning"><i class="bi bi-hourglass-split"></i> CHỜ XỬ LÝ</span>
                                }
                            </small>

                            <div class="dropdown">
                                <button class="btn btn-sm btn-outline-secondary dropdown-toggle fw-bold" type="button" data-bs-toggle="dropdown">
                                    MENU
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" asp-action="Details" asp-route-id="@item.Id"><i class="bi bi-info-square me-2"></i>Chi tiết</a></li>
                                    <li>
                                        <a class="dropdown-item fw-bold zzz-text-mono text-success" asp-action="PrintInvoice" asp-route-maHd="@item.MaHd" target="_blank">
                                            <i class="bi bi-printer-fill me-2"></i> IN BẢN SAO
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item text-danger" asp-action="Delete" asp-route-id="@item.Id"><i class="bi bi-trash3 me-2"></i>Xóa hóa đơn</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5 border-dashed m-5">
            <i class="bi bi-inbox text-muted mb-3" style="font-size: 3rem;"></i>
            <h4 class="fw-bold text-danger zzz-text-mono">KHÔNG CÓ DỮ LIỆU</h4>
            <p class="text-muted fw-bold">Hệ thống chưa ghi nhận hóa đơn nào khớp với bộ lọc.</p>
        </div>
    }
</div>
<script src="~/js/auto-alert.js"></script>
<script src="~/js/PhuongAPI.js"></script>