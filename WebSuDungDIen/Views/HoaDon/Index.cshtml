@model IEnumerable<WebSuDungDIen.ViewModels.HoaDonIndexVM>

@{
    ViewData["Title"] = "Quản lý Hóa Đơn";
    var now = DateTime.Now;
}
@if (TempData["ThongBao"] != null)
{
    <div id="thongBao" class="zzz-notification">
        <div class="zzz-content">
            <span class="zzz-icon">👾</span> <span class="zzz-text">@TempData["ThongBao"]</span>
        </div>
        <div class="zzz-decor-line"></div>
    </div>
}
@if (TempData["Error"] != null)
{
    <div id="thongBao" class="zzz-notification">
        <div class="zzz-content">
            <span class="zzz-icon">👾</span> <span class="zzz-text">@TempData["Error"]</span>
        </div>
        <div class="zzz-decor-line"></div>
    </div>
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Danh sách Hóa đơn</h1>
    <div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-square-fill"></i> PHÁT HÀNH HÓA ĐƠN
        </a>
    </div>
</div>

<div class="card mb-5">
    <div class="card-header">
        <i class="bi bi-sliders me-2"></i>BỘ LỌC TÌM KIẾM
    </div>
    <div class="card-body p-4">
        <form asp-action="Index" method="get" class="row g-3 align-items-end">

            <div class="col-md-2">
                <label class="form-label fw-bold" style="font-size: 0.85rem;">Tỉnh/Thành</label>
                <select id="filterProvince" class="form-select">
                    <option value="">-- Tất cả --</option>
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label fw-bold" style="font-size: 0.85rem;">Phường/Xã</label>
                <select id="filterWard" name="maPhuongApi" class="form-select">
                    <option value="">-- Tất cả --</option>
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label fw-bold" style="font-size: 0.85rem;">Tháng</label>
                <select name="thang" class="form-select" asp-items="ViewBag.ThangList">
                    <option value="">-- ALL --</option>
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label fw-bold" style="font-size: 0.85rem;">Năm</label>
                <select name="nam" class="form-select" asp-items="ViewBag.NamList">
                    <option value="">-- ALL --</option>
                </select>
            </div>

            <div class="col-md-2">
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-search"></i> LỌC
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary" title="Reset">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </div>

            <div class="col-md-2">
                <div class="border-dashed p-2 text-center bg-white rounded">
                    <small class="text-muted text-uppercase fw-bold d-block" style="font-size: 0.7rem;">Tổng số lượng</small>
                    <strong class="fs-4 text-primary">@((Model != null) ? Model.Count().ToString("00") : "00")</strong>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="zzz-data-toolbar">

    <div class="zzz-sync-badge">
        <i class="bi bi-database-fill"></i> [ DATA_SYNC ]
    </div>

    <a asp-action="ExportMongoFormatToExcel" class="btn btn-primary fw-bold zzz-text-mono px-3 py-2">
        <i class="bi bi-file-earmark-excel-fill me-1"></i> XUẤT TỔNG HỢP [XLSX]
    </a>

    <div class="zzz-toolbar-divider"></div>

    <form asp-action="ImportFromExcel" method="post" enctype="multipart/form-data" class="d-flex flex-wrap gap-2 m-0 align-items-center">

        <input type="file" name="file" class="form-control zzz-file-input" accept=".xlsx, .xls" required />

        <button type="submit" class="btn zzz-btn-tech fw-bold px-3 py-2">
            <i class="bi bi-cloud-arrow-up-fill me-1"></i> NẠP DỮ LIỆU CƠ SỞ
        </button>

    </form>
</div>

<div class="container-fluid px-0 mt-4">
    @if (Model != null && Model.Any())
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 position-relative">

                        @if (item.Thang == now.Month && item.Nam == now.Year)
                        {
                            <span class="position-absolute top-0 start-100 translate-middle badge bg-warning text-dark border border-dark" style="z-index: 10; transform: rotate(15deg) !important;">
                                NEW
                            </span>
                        }

                        <div class="card-header d-flex justify-content-between align-items-center bg-white border-bottom-0 pt-3">
                            <span class="badge bg-secondary">#@item.MaHd</span>

                            @if (item.TrangThai)
                            {
                                <span class="badge bg-success">
                                    <i class="bi bi-check-lg me-1"></i>ĐÃ THU
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger animate__animated animate__flash animate__slow animate__infinite">
                                    <i class="bi bi-exclamation-triangle-fill me-1"></i>CHƯA THU
                                </span>
                            }
                        </div>

                        <div class="card-body">
                            <h5 class="card-title fw-bold mb-3 text-truncate text-uppercase" style="font-family: 'Orbitron', sans-serif;">
                                @item.TenKhachHang
                            </h5>

                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <div class="p-2 border-dashed">
                                        <small class="text-muted d-block text-uppercase" style="font-size: 0.7rem;">Kỳ hóa đơn</small>
                                        <span class="fw-bold">T.@item.Thang / @item.Nam</span>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="p-2 border-dashed">
                                        <small class="text-muted d-block text-uppercase" style="font-size: 0.7rem;">Tiêu thụ</small>
                                        <span class="fw-bold">@item.SoDienTieuThu <small>kWh</small></span>
                                    </div>
                                </div>
                            </div>

                            <div class="text-center mt-3 pt-3 border-top border-2 border-dark">
                                <small class="text-uppercase fw-bolder text-muted" style="letter-spacing: 1px;">Thanh toán</small>
                                <h2 class="text-danger fw-black mb-0" style="font-family: 'Orbitron', sans-serif;">
                                    @item.TongThanhToan.ToString("N0")<span class="fs-6 text-dark ms-1">đ</span>
                                </h2>
                            </div>
                        </div>

                        <div class="card-footer d-flex justify-content-between align-items-center">
                            <small class="fw-bold" style="font-size: 0.75rem;">
                                @if (item.TrangThai)
                                {
                                    <span class="text-success"><i class="bi bi-clock-history"></i> @(item.NgayThanhToan?.ToString("dd/MM/yyyy"))</span>
                                }
                                else
                                {
                                    <span class="text-warning"><i class="bi bi-hourglass-split"></i> CHỜ XỬ LÝ</span>
                                }
                            </small>

                            <div class="dropdown">
                                <button class="btn btn-sm btn-outline-secondary dropdown-toggle fw-bold" type="button" data-bs-toggle="dropdown">
                                    MENU
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" asp-action="Details" asp-route-id="@item.Id"><i class="bi bi-info-square me-2"></i>Chi tiết</a></li>
                                    <li>
                                        <a class="dropdown-item fw-bold zzz-text-mono text-success" asp-action="PrintInvoice" asp-route-maHd="@item.MaHd" target="_blank">
                                            <i class="bi bi-printer-fill me-2"></i> IN BẢN SAO
                                        </a>
                                    </li>
                                    @if (!item.TrangThai)
                                    {
                                        <li><a class="dropdown-item text-primary" asp-action="DuyetThanhToan" asp-route-id="@item.Id"><i class="bi bi-shield-check me-2"></i>Duyệt thanh toán</a></li>
                                    }
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item text-danger" asp-action="Delete" asp-route-id="@item.Id"><i class="bi bi-trash3 me-2"></i>Xóa hóa đơn</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5 border-dashed m-5">
            <i class="bi bi-inbox fs-1 text-muted d-block mb-3"></i>
            <h4 class="text-uppercase fw-bold">Không có dữ liệu</h4>
            <p class="text-muted">Hệ thống chưa ghi nhận hóa đơn nào khớp với bộ lọc.</p>
        </div>
    }
</div>
<script src="~/js/auto-alert.js"></script>
<script src="~/js/PhuongAPI.js"></script>