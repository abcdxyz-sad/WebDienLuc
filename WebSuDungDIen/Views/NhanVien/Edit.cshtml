@model WebSuDungDIen.Models.NhanVien

@{
    ViewData["Title"] = "Cập Nhật Hồ Sơ";
}

<div class="border-dashed p-3 mb-4 d-flex flex-column flex-lg-row justify-content-between align-items-center gap-3 zzz-command-panel text-center text-lg-start">
    <h1 class="m-0 zzz-page-title fs-3 fw-bold border-start border-5 ps-3 w-100 w-lg-auto" style="border-left-color: var(--zzz-primary) !important;">
        [ TỆP HỒ SƠ ] CẬP NHẬT DỮ LIỆU
    </h1>
    <div class="d-flex justify-content-center justify-content-lg-end align-items-center gap-3 w-100 w-lg-auto">
        <span class="badge text-dark rounded-0 border border-dark border-2 fs-6 zzz-text-mono px-3 py-2 shadow-sm d-none d-md-block"
              style="background-color: var(--zzz-primary); box-shadow: 2px 2px 0px #000 !important;">
            <span class="text-dark zzz-blink-dot">●</span> TRẠNG THÁI: ĐANG CHỈNH SỬA
        </span>
    </div>
</div>
<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="card position-relative zzz-card-thick">
            <div class="zzz-hazard-line"></div>

            <div class="card-body p-4 p-md-5">
                <form asp-action="Edit" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4"></div>

                    <input type="hidden" asp-for="Id" />

                    <div class="zzz-fieldset">
                        <div class="zzz-fieldset-title">SYS.01 // INF0 TÀI KHOẢN</div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="MaNV" class="form-label zzz-cmd-label">MÃ NHÂN VIÊN</label>
                                <input asp-for="MaNV" class="form-control zzz-terminal-input zzz-locked-input" readonly />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="TenNV" class="form-label zzz-cmd-label">
                                    <span>TÊN NHÂN VIÊN</span>
                                    <span class="zzz-text-req zzz-text-danger-req">* REQ</span>
                                </label>
                                <input asp-for="TenNV" class="form-control zzz-terminal-input" />
                                <span asp-validation-for="TenNV" class="text-danger zzz-text-danger-req d-block mt-1"></span>
                            </div>
                        </div>
                    </div>

                    <div class="zzz-fieldset">
                        <div class="zzz-fieldset-title">SYS.02 // HỒ SƠ CHI TIẾT</div>

                        <div class="row">
                            <div class="col-md-12 mb-3">
                                <label asp-for="DiaChi" class="form-label zzz-cmd-label">TỌA ĐỘ / ĐỊA CHỈ</label>
                                <input asp-for="DiaChi" class="form-control zzz-terminal-input" />
                                <span asp-validation-for="DiaChi" class="text-danger zzz-text-danger-req d-block mt-1"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="DienThoai" class="form-label zzz-cmd-label">KÊNH LIÊN LẠC (SĐT)</label>
                                <input asp-for="DienThoai" class="form-control zzz-terminal-input" />
                                <span asp-validation-for="DienThoai" class="text-danger zzz-text-danger-req d-block mt-1"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="ChucVu" class="form-label zzz-cmd-label">PHÂN QUYỀN (CHỨC VỤ)</label>
                                <select asp-for="ChucVu" class="form-select zzz-terminal-input" asp-items="ViewBag.ChucVuList">
                                    <option value="">-- CHỈ ĐỊNH QUYỀN --</option>
                                </select>
                                <span asp-validation-for="ChucVu" class="text-danger zzz-text-danger-req d-block mt-1"></span>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex flex-column flex-md-row gap-3 mt-4">
                        <button type="submit" class="btn btn-primary fw-bold fs-5 flex-grow-1 py-3 border-dark border-3 rounded-0 shadow-sm">
                            <i class="fas fa-bolt me-2"></i> LƯU CẬP NHẬT
                        </button>
                        <a asp-action="Index" class="btn zzz-btn-cancel fw-bold fs-5 px-md-5 py-3 border-dark border-3 rounded-0 d-flex align-items-center justify-content-center">
                            <i class="fas fa-undo me-2"></i> HỦY BỎ
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}