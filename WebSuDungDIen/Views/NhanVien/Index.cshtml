@model IEnumerable<WebSuDungDIen.Models.NhanVien>

@{
    ViewData["Title"] = "Quản lý nhân viên";
}

<div class="border-dashed p-3 mb-4 d-flex justify-content-between align-items-center flex-wrap gap-3 zzz-command-panel">
    <h1 class="m-0 zzz-page-title">
        [ TỆP HỒ SƠ ] NHÂN SỰ
    </h1>

    <div class="d-flex align-items-center gap-3">
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-square-fill me-1"></i> THỀM VÀO NHÂN SỰ MỚI
        </a>
    </div>
</div>

<div class="card position-relative">
    <div class="card-body p-0" style="overflow: visible;">
        <table class="table table-hover mb-0 zzz-data-table">
            <thead>
                <tr>
                    <th class="zzz-col-10 text-center">MÃ NHÂN VIÊN</th>
                    <th class="zzz-col-20">HỌ VÀ TÊN</th>
                    <th>EMAIL</th>
                    <th>SỐ ĐIỆN THOẠI</th>
                    <th>CHỨC VỤ</th>
                    <th class="zzz-col-12 text-center">TÌNH TRẠNG</th>
                    <th class="text-center zzz-col-10">CHỨC NĂNG</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <span class="badge bg-secondary zzz-badge-id">
                                #@Html.DisplayFor(modelItem => item.MaNV)
                            </span>
                        </td>
                        <td class="zzz-text-name">
                            @Html.DisplayFor(modelItem => item.TenNV)
                        </td>
                        <td class="zzz-text-mono">
                            @item.User?.Email
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.DienThoai)
                        </td>
                        <td>
                            <span class="zzz-tag">@Html.DisplayFor(modelItem => item.ChucVu)</span>
                        </td>
                        <td class="text-center">
                            @if (item.TrangThai)
                            {
                                <span class="badge bg-success zzz-status-badge">
                                    <span class="zzz-blink-dot zzz-status-dot">●</span> ONLINE
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger zzz-status-badge zzz-status-offline">
                                    <i class="zzz-status-x">×</i> OFFLINE
                                </span>
                            }
                        </td>
                        <td class="text-center">
                            <div class="dropdown">
                                <button class="btn btn-outline-secondary dropdown-toggle zzz-btn-action" type="button" id="dropdownMenuButton_@item.Id" data-bs-toggle="dropdown" aria-expanded="false">
                                    CHỌN
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="dropdownMenuButton_@item.Id">
                                    <li>
                                        <a class="dropdown-item" asp-action="Details" asp-route-id="@item.Id">XEM HỒ SƠ</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-action="Edit" asp-route-id="@item.Id">CẬP NHẬT</a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item text-danger" asp-action="Delete" asp-route-id="@item.Id">XÓA DỮ LIỆU</a>
                                    </li>
                                </ul>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>