@model IEnumerable<WebSuDungDIen.Models.NhanVien>

@{
    ViewData["Title"] = "Quản Lý Nhân Viên";
}

<div class="border-dashed p-3 p-lg-4 mb-4 d-flex flex-column flex-lg-row justify-content-between align-items-center gap-3 zzz-command-panel border-dark border-3 bg-white">

    <div class="d-inline-block text-nowrap bg-transparent py-2 w-100 w-lg-auto text-center text-lg-start zzz-title-wrap">
        <h1 class="m-0 zzz-page-title fw-bold text-uppercase fs-3 fs-lg-2 border-start border-primary border-5 ps-3 text-nowrap d-inline-block"
            style="border-left-color: var(--zzz-primary) !important; letter-spacing: 1px;"
            data-intro="Chào mừng đến với khu vực quản lý nhân viên!"
            data-step="1">
            [ TỆP HỒ SƠ ] NHÂN SỰ
        </h1>
    </div>

    <div class="d-flex align-items-center gap-3 w-100 w-lg-auto justify-content-center justify-content-lg-end">
        <div class="d-inline-block shadow-sm"
             data-intro="Bấm vào nút này để lập hóa đơn cho khách theo phường!"
             data-step="2">
            <a asp-action="Create"
               class="btn btn-primary fw-bold border-dark border-2 rounded-0 px-4 py-2 zzz-text-mono text-nowrap d-inline-flex align-items-center">
                <i class="bi bi-plus-square-fill me-2"></i> Thêm vào nhân viên
            </a>
        </div>
    </div>
</div>

<div class="card position-relative border-dark border-3 rounded-0 shadow-lg"
     data-intro="Dữ liệu của nhân viên được hiển thị tại đây!"
     data-step="3"
     data-position="bottom">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0 zzz-table align-middle">
                <thead class="table-dark text-nowrap zzz-text-mono">
                    <tr>
                        <th style="min-width: 130px;">MÃ NV</th>
                        <th style="min-width: 200px;">HỌ VÀ TÊN</th>
                        <th style="min-width: 220px;">EMAIL</th>
                        <th style="min-width: 150px;">SỐ ĐIỆN THOẠI</th>
                        <th style="min-width: 150px;">CHỨC VỤ</th>
                        <th class="text-center" style="min-width: 140px;">CHỨC NĂNG</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="border-bottom border-dark-subtle">
                            <td data-label="MÃ NV" class="zzz-text-mono fw-bold">
                                <span class="badge bg-secondary zzz-badge-id fs-6 shadow-sm border border-dark">
                                    #@Html.DisplayFor(modelItem => item.MaNV)
                                </span>
                            </td>
                            <td data-label="HỌ VÀ TÊN" class="zzz-text-name text-danger fw-bold fs-6 text-wrap">
                                @Html.DisplayFor(modelItem => item.TenNV)
                            </td>
                            <td data-label="EMAIL" class="zzz-text-mono fw-bold">
                                @item.User?.Email
                            </td>
                            <td data-label="SỐ ĐIỆN THOẠI" class="zzz-text-mono fw-bold">
                                @Html.DisplayFor(modelItem => item.DienThoai)
                            </td>
                            <td data-label="CHỨC VỤ">
                                @if (item.ChucVu == "Admin")
                                {
                                    <span class="zzz-tag badge bg-warning text-dark border border-dark shadow-sm fs-6 fw-bold">
                                        <i class="fas fa-crown me-1"></i> ADMIN
                                    </span>
                                }
                                else if (item.ChucVu == "NhanVien")
                                {
                                    <span class="zzz-tag badge bg-light text-dark border border-dark shadow-sm fs-6 fw-bold">
                                        <i class="fas fa-user-tie me-1"></i> NHÂN VIÊN
                                    </span>
                                }
                                else
                                {
                                    <span class="zzz-tag badge bg-secondary text-white border border-dark shadow-sm fs-6 fw-bold">
                                        @item.ChucVu
                                    </span>
                                }
                            </td>
                            <td data-label="CHỨC NĂNG" class="text-md-center">
                                <div class="dropdown">
                                    <button class="btn btn-dark border-2 rounded-0 dropdown-toggle zzz-btn-action fw-bold w-100 w-md-auto text-end text-md-center px-4"
                                            type="button"
                                            id="dropdownMenuButton_@item.Id"
                                            data-bs-toggle="dropdown"
                                            aria-expanded="false"
                                            data-bs-boundary="window"
                                            data-bs-strategy="fixed">
                                        CHỌN
                                    </button>

                                    <ul class="dropdown-menu dropdown-menu-end border-dark border-2 rounded-0 shadow"
                                        aria-labelledby="dropdownMenuButton_@item.Id"
                                        style="z-index: 9999;"
                                        data-intro="Nhấn vào đây để chọn chức năng quản lý!"
                                        data-step="4">
                                        <li>
                                            <a class="dropdown-item fw-bold zzz-text-mono" asp-action="Details" asp-route-id="@item.Id">
                                                <i class="bi bi-person-lines-fill me-2"></i>XEM HỒ SƠ
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item fw-bold zzz-text-mono" asp-action="Edit" asp-route-id="@item.Id">
                                                <i class="bi bi-pencil-square me-2"></i>CẬP NHẬT
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider border-dark border-2"></li>
                                        <li>
                                            <a class="dropdown-item text-danger fw-bold zzz-text-mono" asp-action="Delete" asp-route-id="@item.Id">
                                                <i class="bi bi-trash-fill me-2"></i>XÓA DỮ LIỆU
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>