@model WebSuDungDIen.Models.NhanVien

@{
    ViewData["Title"] = "Trích Xuất Hồ Sơ Đặc Vụ";
}

<div class="container-fluid p-0 zzz-container-dossier">

    <div class="border-dashed p-3 mb-4 d-flex justify-content-between align-items-center flex-wrap gap-3 zzz-command-panel border-dark border-3">
        <h1 class="m-0 zzz-page-title fw-bold text-uppercase">
            <i class="fas fa-fingerprint text-danger me-2"></i> TRÍCH XUẤT HỒ SƠ ĐẶC VỤ
        </h1>
        <div class="d-flex align-items-center gap-3">
            <span class="zzz-sys-status text-primary fw-bold">
                MÃ NHÂN SỰ: <span class="zzz-text-mono text-muted">@Model.MaNV</span>
            </span>
        </div>
    </div>

    <div class="row g-4 mb-4 align-items-stretch">

        <div class="col-lg-4 col-md-5">
            <div class="card border-dark border-3 rounded-0 zzz-id-card shadow-lg h-100 position-relative overflow-hidden">

                <div class="zzz-hazard-strip"></div>

                <div class="card-body p-4 d-flex flex-column align-items-center text-center mt-3">

                    <i class="fas fa-user-tie mb-3 zzz-avatar-icon"></i>

                    <h2 class="fw-bolder zzz-text-mono text-dark mb-0 border-bottom border-dark border-3 pb-2 w-100 text-uppercase zzz-agent-name">
                        @Model.TenNV
                    </h2>
                    <div class="small fw-bold zzz-text-mono mb-4 mt-2 zzz-sub-label">ID: #@Model.MaNV</div>

                    @if (Model.TrangThai)
                    {
                        <span class="badge zzz-badge-verified fs-5 px-4 py-3 w-100 zzz-text-mono rounded-0 border-3 mb-3">
                            <i class="fas fa-wifi me-1"></i> ONLINE (HOẠT ĐỘNG)
                        </span>
                    }
                    else
                    {
                        <span class="badge border border-dark border-3 bg-dark text-danger fs-5 px-4 py-3 w-100 zzz-text-mono rounded-0 zzz-badge-offline">
                            <i class="fas fa-power-off me-1"></i> OFFLINE (VÔ HIỆU)
                        </span>
                    }

                    <div class="p-2 border border-dark border-2 bg-white text-dark fw-bold w-100 zzz-text-mono">
                        CẤP BẬC: @Model.ChucVu.ToUpper()
                    </div>

                    <div class="mt-auto w-100 pt-3 border-top border-dark border-3 text-start zzz-text-mono small mt-4 fw-bold text-dark">
                        <div class="zzz-sub-label">SYS.LOG // TRUY XUẤT:</div>
                        <div><i class="fas fa-angle-right me-1"></i> DATE: @DateTime.Now.ToString("dd/MM/yyyy")</div>
                        <div><i class="fas fa-angle-right me-1"></i> TIME: @DateTime.Now.ToString("HH:mm:ss")</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-8 col-md-7">
            <div class="card border-dark border-3 rounded-0 bg-white shadow-lg h-100 d-flex flex-column">

                <div class="card-header bg-white border-bottom border-dark border-3 p-3 d-flex justify-content-between align-items-center">
                    <h4 class="m-0 zzz-text-mono fw-bold text-dark"><i class="fas fa-folder-open me-2 text-warning"></i>DỮ LIỆU ĐẶC VỤ</h4>
                    <i class="fas fa-barcode fs-2 text-dark opacity-25"></i>
                </div>

                <div class="card-body p-4 p-md-5 d-flex flex-column h-100">
                    <div class="row g-4 mb-5">

                        <div class="col-md-6">
                            <label class="zzz-text-mono text-muted fw-bold small">TÍN HIỆU LIÊN LẠC (SĐT)</label>
                            <div class="fs-4 fw-bold zzz-badge-id">@Model.DienThoai</div>
                        </div>

                        <div class="col-md-6">
                            <label class="zzz-text-mono text-muted fw-bold small">TÀI KHOẢN LIÊN KẾT (EMAIL)</label>
                            <div class="fs-5 fw-bold zzz-text-mono text-dark text-break mt-1 border-bottom border-dark border-2 pb-1">
                                @(Model.User?.Email ?? "[ CHƯA CÓ EMAIL ]")
                            </div>
                        </div>

                        <div class="col-12">
                            <label class="zzz-text-mono text-muted fw-bold small">ĐỊA CHỈ THƯỜNG TRÚ</label>
                            <div class="fs-5 fw-bold bg-light p-3 border border-dark border-2 mt-1">
                                <i class="fas fa-map-marker-alt text-danger me-2"></i>@Model.DiaChi
                            </div>
                        </div>
                    </div>

                    <div class="mt-auto">
                        <h5 class="fw-bold zzz-text-mono border-bottom border-dark border-3 pb-2 mb-3">
                            <i class="fas fa-terminal me-2"></i> BẢNG LỆNH THỰC THI
                        </h5>

                        <div class="d-flex flex-wrap gap-3">
                            <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary fw-bold border-dark border-3 rounded-0 px-4 py-2 flex-grow-1">
                                <i class="fas fa-pen me-2"></i> CẬP NHẬT DỮ LIỆU
                            </a>

                            <a asp-action="Index" class="btn zzz-btn-cancel fw-bold border-dark border-3 rounded-0 px-4 py-2 flex-grow-1 text-center zzz-btn-action">
                                <i class="fas fa-undo me-2"></i> DANH SÁCH NHÂN SỰ
                            </a>
                        </div>
                    </div>

                </div>

            </div>
        </div>
    </div>

</div>