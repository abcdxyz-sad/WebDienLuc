@model IEnumerable<ChiSoDienIndexVM>

@{
    ViewData["Title"] = "Chỉ số điện";
}

@if (TempData["ThongBao"] != null)
{
    <div id="thongBao" class="zzz-notification">
        <div class="zzz-content">
            <span class="zzz-icon">👾</span> <span class="zzz-text">@TempData["ThongBao"]</span>
        </div>
        <div class="zzz-decor-line"></div>
    </div>
}

<div class="border-dashed p-3 p-lg-4 mb-4 zzz-command-panel border-dark border-3 bg-white">

    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 border-bottom border-dark pb-3 mb-3">

        <h1 class="m-0 zzz-page-title fw-bold text-uppercase text-center text-lg-start w-100 w-lg-auto border-start border-primary border-5 ps-3" style="border-left-color: var(--zzz-primary) !important;">
            [ TỆP DỮ LIỆU ] CHỈ SỐ ĐIỆN
        </h1>

        <div class="d-flex align-items-center gap-3 w-100 w-lg-auto ms-lg-auto justify-content-center justify-content-lg-end">
            @if (!string.IsNullOrEmpty(ViewBag.MaPhuongApi))
            {
                <a asp-controller="ChiSoDien" asp-action="Create" asp-route-maPhuongApi="@ViewBag.MaPhuongApi"
                   class="btn btn-primary w-100 w-lg-auto flex-lg-grow-0 align-self-lg-center fw-bold border-dark border-2 rounded-0 shadow-sm text-nowrap py-2 py-lg-1"
                   style="max-width: max-content;">
                    <i class="bi bi-plus-square-fill me-1"></i> NHẬP CHỈ SỐ
                </a>
            }
        </div>

    </div>

    <form method="get" id="filterForm" class="row g-3 align-items-end">
        <div class="col-12 col-lg-3">
            <label class="fw-bold zzz-text-mono small mb-1">Tỉnh / Thành phố</label>
            <select name="maTinh" id="selectTinh" class="form-select border-dark border-2 rounded-0" asp-items="ViewBag.DanhSachTinh">
                <option value="">-- Tất cả --</option>
            </select>
        </div>

        <div class="col-12 col-lg-3">
            <label class="fw-bold zzz-text-mono small mb-1">Phường / Xã</label>
            <select name="maPhuongApi" id="ward" class="form-select border-dark border-2 rounded-0" asp-items="ViewBag.DanhSachPhuong">
                <option value="">-- Chọn Phường/Xã --</option>
            </select>
        </div>

        <div class="col-12 col-lg-6">
            <label class="fw-bold zzz-text-mono small mb-1">Tra cứu nhanh</label>
            <div class="input-group border border-dark border-2 rounded-0 shadow-sm">
                <input type="text" id="liveSearchInput" name="searchKeyword" value="@ViewBag.SearchKeyword" class="form-control border-0 rounded-0" placeholder="Tên KH, Điện thoại..." />
                <button type="submit" class="btn btn-primary fw-bold px-3 px-lg-4 border-start border-dark border-2 rounded-0">
                    <i class="bi bi-search ms-1"></i> TÌM
                </button>
            </div>
        </div>
    </form>
</div>

<div id="vung-du-lieu-thay-doi">
    <div class="card position-relative border-dark border-3 rounded-0 bg-white" style="box-shadow: 6px 6px 0px var(--zzz-black);">
        <div class="card-body p-0" style="overflow: visible;">
            <div class="table-responsive">
                <table class="table table-hover mb-0 zzz-table align-middle">
                    <thead class="table-dark zzz-text-mono">
                        <tr class="text-nowrap" style="font-size: 0.9rem;">
                            <th style="min-width: 140px;">MÃ KHÁCH</th>
                            <th style="min-width: 200px;">KHÁCH HÀNG</th>
                            <th style="min-width: 250px;">ĐỊA CHỈ</th>
                            <th class="text-center" style="min-width: 110px;">KỲ CHỐT</th>
                            <th class="text-end" style="min-width: 110px;">CHỈ SỐ CŨ</th>
                            <th class="text-end text-warning" style="min-width: 120px;">CHỈ SỐ MỚI</th>
                            <th class="text-center" style="min-width: 130px;">TIÊU THỤ</th>
                            <th class="text-center" style="min-width: 100px;">LỆNH</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr class="border-bottom border-dark-subtle">

                                    <td data-label="MÃ KHÁCH">
                                        <span class="badge bg-secondary border border-dark text-white zzz-text-mono fs-6 shadow-sm">
                                            #@item.KhachHangId.Substring(0, Math.Min(8, item.KhachHangId.Length))
                                        </span>
                                    </td>

                                    <td data-label="KHÁCH HÀNG">
                                        <div class="zzz-text-name fs-6 fw-bolder text-uppercase text-wrap" style="color: var(--zzz-black); line-height: 1.2;">
                                            @item.TenKh
                                        </div>
                                    </td>

                                    <td data-label="ĐỊA CHỈ" class="zzz-text-mono small fw-bold text-wrap">
                                        @item.DiaChi
                                    </td>
                                    <td data-label="KỲ CHỐT" class="text-lg-center zzz-text-mono fw-bold">
                                        @if (item.ThangGanNhat == 0)
                                        {
                                            <span class="badge bg-danger text-white small border border-dark">CHƯA CÓ</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark border border-dark fs-6 shadow-sm">T.@item.ThangGanNhat/@item.NamGanNhat</span>
                                        }
                                    </td>

                                    <td data-label="CHỈ SỐ CŨ" class="text-lg-end">
                                        <span class="badge bg-secondary border border-dark text-white zzz-text-mono fs-6 shadow-sm">@item.ChiSoCu</span>
                                    </td>

                                    <td data-label="CHỈ SỐ MỚI" class="text-lg-end">
                                        <span class="badge bg-warning text-dark zzz-text-mono fs-6 shadow-sm border border-dark">@item.ChiSoMoi</span>
                                    </td>

                                    <td data-label="TIÊU THỤ" class="text-lg-center">
                                        @if (item.ThangGanNhat == 0)
                                        {
                                            <span class="text-muted fw-bold">-</span>
                                        }
                                        else if (item.ChiSoCu == 0)
                                        {
                                            <span class="badge zzz-status-badge border border-dark border-2 shadow-sm text-nowrap fw-bold" style="background-color: var(--zzz-blue); color: var(--zzz-black);">
                                                <i class="fas fa-wrench me-1"></i> CHỈ SỐ MỚI LẮP ĐẶT
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger zzz-status-badge zzz-status-offline border border-dark border-2 shadow-sm text-nowrap">
                                                <i class="fas fa-bolt me-1"></i> @item.DienTieuThu <span class="text-lowercase">kWh</span>
                                            </span>
                                        }
                                    </td>
                                    <td data-label="LỆNH" class="text-lg-center">
                                        <div class="dropdown">
                                            <button class="btn btn-outline-dark border-2 rounded-0 dropdown-toggle zzz-btn-action fw-bold w-100 w-lg-auto" type="button" id="dropdown_@item.KhachHangId" data-bs-toggle="dropdown" aria-expanded="false">
                                                CHỌN
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end border-dark border-2 rounded-0 shadow" aria-labelledby="dropdown_@item.KhachHangId">
                                                <li>
                                                    <a class="dropdown-item fw-bold zzz-text-mono" asp-action="Details" asp-route-id="@item.KhachHangId"><i class="bi bi-info-square me-2 text-primary"></i>XEM CHI TIẾT</a>
                                                </li>
                                                <li>
                                                    <a class="dropdown-item fw-bold zzz-text-mono" asp-controller="ChiSoDien" asp-action="Edit" asp-route-khachHangId="@item.KhachHangId"><i class="bi bi-pencil-square me-2 text-success"></i>CẬP NHẬT</a>
                                                </li>
                                            </ul>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-2 border-0">
                                    <div class="text-center py-5">
                                        <i class="bi bi-search text-muted mb-3" style="font-size: 3rem;"></i>
                                        <h4 class="fw-bold text-danger zzz-text-mono">KHÔNG TÌM THẤY DỮ LIỆU.</h4>
                                        <p class="text-muted fw-bold">Khu vực này trống hoặc từ khóa tìm kiếm không khớp.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/auto-alert.js"></script>
    <script>
        // 1. CODE ẨN PHƯỜNG CỦA SẾP (GIỮ NGUYÊN BẢN SẮC)
        const phuongCoData = @Html.Raw(Json.Serialize(ViewBag.DanhSachPhuongCoData ?? new List<string>()));
        const phuongCoDataString = phuongCoData.map(String);
        const wardSelect = document.getElementById('ward');

        if (wardSelect) {
            const observer = new MutationObserver(function(mutations) {
                observer.disconnect();
                $("#ward option").each(function() {
                    let val = String($(this).val());
                    if (val !== "" && !phuongCoDataString.includes(val)) {
                        $(this).remove();
                    }
                });
                observer.observe(wardSelect, { childList: true });
            });
            observer.observe(wardSelect, { childList: true });
        }

        // 2. LIVE SEARCH CỰC MƯỢT
        let timeout = null;
        let currentAbortController = null;

        document.getElementById('liveSearchInput').addEventListener('input', function (e) {
            clearTimeout(timeout);

            timeout = setTimeout(function () {
                let form = e.target.closest('form');
                let searchParams = new URLSearchParams(new FormData(form)).toString();

                let url = window.location.pathname + '?' + searchParams;

                if (currentAbortController) {
                    currentAbortController.abort();
                }
                currentAbortController = new AbortController();

                fetch(url, { signal: currentAbortController.signal })
                    .then(response => response.text())
                    .then(html => {
                        let parser = new DOMParser();
                        let doc = parser.parseFromString(html, 'text/html');

                        let newContent = doc.getElementById('vung-du-lieu-thay-doi').innerHTML;
                        document.getElementById('vung-du-lieu-thay-doi').innerHTML = newContent;
                    })
                    .catch(error => {
                        if (error.name === 'AbortError') {
                            console.log('Đã hủy request cũ!');
                        } else {
                            console.error('Lỗi Data:', error);
                        }
                    });

            }, 300);
        });
    </script>
}