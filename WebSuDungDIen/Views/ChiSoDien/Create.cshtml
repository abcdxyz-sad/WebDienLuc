@model List<ChiSoDienIndexVM>

@{
    ViewData["Title"] = "Ghi Chỉ Số Phường";
    var thangMacDinh = ViewBag.Thang ?? DateTime.Now.Month;
    var namMacDinh = ViewBag.Nam ?? DateTime.Now.Year;
}

<div class="border-dashed p-3 mb-4 d-flex flex-column flex-lg-row justify-content-between align-items-center flex-wrap gap-3 zzz-command-panel text-center text-lg-start">
    <h1 class="m-0 zzz-page-title">
        [ CHIẾN DỊCH ] NHẬP CHỈ SỐ ĐIỆN TỔNG
    </h1>
    <div class="d-flex align-items-center gap-3 w-100 w-lg-auto justify-content-center">
        <span class="zzz-sys-status">
            HỆ THỐNG: <span class="zzz-blink-dot zzz-text-yellow">●</span> ĐANG CHỜ DỮ LIỆU
        </span>
    </div>
</div>

@if (TempData["ThongBao"] != null)
{
    <div id="thongBao" class="zzz-notification">
        <div class="zzz-content">
            <span class="zzz-icon">👾</span> <span class="zzz-text">@TempData["ThongBao"]</span>
        </div>
        <div class="zzz-decor-line"></div>
    </div>
}

<div class="card position-relative zzz-card-thick">
    <div class="zzz-hazard-line"></div>

    <div class="card-body p-3 p-lg-4">
        <form asp-action="Create" method="post">

            <div class="zzz-fieldset">
                <div class="zzz-fieldset-title">SYS.01 // KỲ GHI CHỈ SỐ</div>
                <div class="row">
                    <div class="col-6 col-lg-3 mb-3">
                        <label class="form-label zzz-cmd-label">THÁNG <span class="zzz-text-req zzz-text-danger-req">* REQ</span></label>
                        <input type="number" name="Thang" value="@thangMacDinh" class="form-control zzz-terminal-input text-center" required min="1" max="12" />
                    </div>

                    <div class="col-6 col-lg-3 mb-3">
                        <label class="form-label zzz-cmd-label">NĂM <span class="zzz-text-req zzz-text-danger-req">* REQ</span></label>
                        <input type="number" name="Nam" value="@namMacDinh" class="form-control zzz-terminal-input text-center" required min="2000" />
                    </div>
                </div>
            </div>

            <div class="zzz-fieldset">
                <div class="zzz-fieldset-title">SYS.02 // DANH SÁCH MỤC TIÊU</div>

                <div class="table-responsive">
                    <table class="table table-hover table-bordered mb-0 zzz-data-table align-middle">
                        <thead class="table-dark">
                            <tr class="text-nowrap" style="font-size: 0.95rem;">
                                <th style="min-width: 220px;">TÊN KHÁCH HÀNG</th>
                                <th style="min-width: 250px;">ĐỊA CHỈ</th>
                                <th class="text-center" style="min-width: 140px;">KỲ GẦN NHẤT</th>
                                <th class="text-center" style="min-width: 120px;">CHỈ SỐ CŨ</th>
                                <th style="min-width: 150px;">CHỈ SỐ MỚI</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Count; i++)
                            {
                                <tr>
                                    <td class="font-weight-bold">
                                        <input type="hidden" asp-for="@Model[i].KhachHangId" />
                                        <input type="hidden" asp-for="@Model[i].TenKh" />
                                        <input type="hidden" asp-for="@Model[i].DiaChi" />
                                        <input type="hidden" asp-for="@Model[i].ThangGanNhat" />
                                        <input type="hidden" asp-for="@Model[i].NamGanNhat" />
                                        <input type="hidden" asp-for="@Model[i].ChiSoCu" />

                                        @Model[i].TenKh
                                    </td>

                                    <td class="small text-wrap">@Model[i].DiaChi</td>

                                    <td class="text-center zzz-text-mono text-nowrap">
                                        @(Model[i].ThangGanNhat)/@(Model[i].NamGanNhat)
                                    </td>

                                    <td class="text-center zzz-text-mono text-danger font-weight-bold">
                                        @Model[i].ChiSoCu
                                    </td>

                                    <td>
                                        <input type="number" asp-for="@Model[i].ChiSoMoi" class="form-control zzz-terminal-input" placeholder="Nhập số..." style="min-width: 100px;" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <hr class="mt-4 mb-4 zzz-form-divider" />

            <div class="d-flex flex-column flex-lg-row gap-3">
                <button type="submit" class="btn btn-primary zzz-btn-large flex-grow-1 w-100">
                    <i>⚡</i> LƯU TOÀN BỘ CHỈ SỐ
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary zzz-btn-large w-100 w-lg-auto text-center">
                    <i>◄</i> TRỞ VỀ DANH SÁCH
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/auto-alert.js"></script>
}