@model List<ChiSoDienIndexVM>

@{
    ViewData["Title"] = "Ghi Chỉ Số Phường";
    var thangMacDinh = ViewBag.Thang ?? DateTime.Now.Month;
    var namMacDinh = ViewBag.Nam ?? DateTime.Now.Year;
}

<div class="border-dashed p-3 p-md-4 mb-4 d-flex justify-content-between align-items-center flex-wrap gap-3 bg-white border-dark border-3">
    <h1 class="m-0 zzz-page-title fw-black text-uppercase border-start border-5 ps-3" style="border-left-color: var(--zzz-primary) !important; font-family: 'Orbitron', sans-serif;">
        NHẬP CHỈ SỐ MỚI CHO KHÁCH 
    </h1>
    <div class="d-flex align-items-center gap-3">
        <div class="px-3 py-2 fw-bold zzz-text-mono border border-dark border-2 shadow-sm text-nowrap" style="background-color: var(--zzz-primary); color: #000;">
            <span class="zzz-blink-dot text-dark">●</span> ĐANG CHỜ NHẬP LIỆU
        </div>
    </div>
</div>

<div class="card position-relative border-dark border-3 rounded-0 bg-white" style="box-shadow: 6px 6px 0px var(--zzz-black, #000);">

    <div class="zzz-hazard-line" style="height: 12px; background: repeating-linear-gradient(-45deg, #000, #000 15px, var(--zzz-primary) 15px, var(--zzz-primary) 30px); border-bottom: 3px solid #000;"></div>

    <div class="card-body p-4 p-md-5">
        <form asp-action="Create" method="post">
            <input type="hidden" name="maPhuongApi" value="@ViewBag.MaPhuongApi" />
            <input type="hidden" name="startTour" value="@ViewBag.StartTour" />
            <div class="position-relative border border-dark border-3 p-4 mb-5 bg-white" style="box-shadow: 4px 4px 0px rgba(0,0,0,0.1);">

                <div class="fw-black zzz-text-mono fw-bold px-3 py-1 position-absolute border border-dark border-2"
                     style="background-color: var(--zzz-primary); color: #000; top: 0; left: -3px; transform: translateY(-50%); font-size: 1.1rem; letter-spacing: 1px; box-shadow: 2px 2px 0px #000;">
                    SYS.01 // KỲ GHI CHỈ SỐ
                </div>

                <div class="row g-4 align-items-end mt-1"   >
                    <div class="col-12 col-md-6 col-lg-4"
                         data-intro="Chọn tháng để nhập chỉ số điện (tháng khi chọn phải là tháng mới ở mỗi kỳ cập nhật chỉ số mới)!"
                         data-step="1">
                        <div class="row g-3">
                            <div class="col-6">
                                <label class="form-label zzz-cmd-label fw-bold small text-muted text-uppercase mb-1">>_ THÁNG <span class="text-danger">*</span></label>
                                <input type="number" name="Thang" value="@thangMacDinh" class="form-control zzz-terminal-input text-center fw-bold fs-5 border-dark border-2 rounded-0 shadow-sm" required min="1" max="12" />
                            </div>

                            <div class="col-6">
                                <label class="form-label zzz-cmd-label fw-bold small text-muted text-uppercase mb-1">>_ NĂM <span class="text-danger">*</span></label>
                                <input type="number" name="Nam" value="@namMacDinh" class="form-control zzz-terminal-input text-center fw-bold fs-5 border-dark border-2 rounded-0 shadow-sm" required min="2000" />
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6 col-lg-8 d-flex gap-3 justify-content-md-end mt-4 mt-md-0">
                        <a asp-action="Index" class="btn zzz-btn-cancel fw-bold text-center px-4 py-2 border-dark border-2 rounded-0 d-flex align-items-center zzz-text-mono">
                            <i class="fas fa-arrow-left me-2"></i> QUAY LẠI
                        </a>
                        <div class="d-inline-block shadow-sm"
                             data-intro="Nhấn vào nút này để nhập vào chỉ số mới!"
                             data-step="2">
                            <button type="submit" class="btn btn-primary fw-bolder px-4 py-2 border-dark border-2 rounded-0 d-flex align-items-center zzz-text-mono">
                                <i class="fas fa-save me-2"></i> LƯU TOÀN BỘ DATA
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="position-relative border border-dark border-3 bg-white mt-5" style="box-shadow: 4px 4px 0px #000;">

                <div class="bg-dark text-white fw-bold zzz-text-mono px-3 py-1 position-absolute border border-dark border-2"
                     style="top: 0; left: -3px; transform: translateY(-50%); font-size: 1.1rem; letter-spacing: 1px; box-shadow: 2px 2px 0px var(--zzz-primary);">
                    SYS.02 // DANH SÁCH KHÁCH HÀNG
                </div>

                <div class="table-responsive pt-4 px-3 pb-3"
                     data-intro="Lưu ý: nhớ nhập vào chỉ số mới nha!"
                     data-step="3">
                    <table class="table table-hover table-bordered border-dark border-2 mb-0 zzz-data-table align-middle">
                        <thead class="table-dark zzz-text-mono">
                            <tr class="text-nowrap" style="font-size: 0.9rem; letter-spacing: 1px;">
                                <th style="width: 150px;" class="py-3 px-3 text-center">MÃ KH</th>

                                <th style="min-width: 250px;" class="py-3 px-3">TÊN KHÁCH HÀNG</th>
                                <th style="min-width: 300px;" class="py-3">ĐỊA CHỈ</th>
                                <th class="text-center py-3" style="min-width: 140px;">KỲ GẦN NHẤT</th>
                                <th class="text-center py-3" style="min-width: 120px; color: var(--zzz-primary);">CHỈ SỐ CŨ</th>
                                <th class="py-3 px-3 text-center" style="min-width: 180px;">CHỈ SỐ MỚI</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Count > 0)
                            {
                                @for (int i = 0; i < Model.Count; i++)
                                {
                                    <tr>
                                        <td class="text-center px-3 fw-bold zzz-text-mono bg-light">
                                            <input type="hidden" asp-for="@Model[i].KhachHangId" />
                                            <input type="hidden" asp-for="@Model[i].MaKh" /> <input type="hidden" asp-for="@Model[i].TenKh" />
                                            <input type="hidden" asp-for="@Model[i].DiaChi" />
                                            <input type="hidden" asp-for="@Model[i].ThangGanNhat" />
                                            <input type="hidden" asp-for="@Model[i].NamGanNhat" />
                                            <input type="hidden" asp-for="@Model[i].ChiSoCu" />

                                            <div class="fs-6 text-dark text-uppercase" style="letter-spacing: 1px;">
                                                #@Model[i].MaKh
                                            </div>
                                        </td>

                                        <td class="fw-bolder px-3">
                                            <div class="fs-6 text-dark text-uppercase zzz-text-mono" style="letter-spacing: 0.5px;">
                                                @Model[i].TenKh
                                            </div>
                                        </td>

                                        <td class="small fw-bold text-muted zzz-text-mono text-wrap">
                                            @Model[i].DiaChi
                                        </td>

                                        <td class="text-center zzz-text-mono text-nowrap">
                                            <span class="badge bg-light text-dark border border-dark border-2 px-2 py-1 shadow-sm fs-6">
                                                @(Model[i].ThangGanNhat)/@(Model[i].NamGanNhat)
                                            </span>
                                        </td>

                                        <td class="text-center zzz-text-mono fw-black fs-5 text-danger">
                                            @Model[i].ChiSoCu
                                        </td>

                                        <td class="text-center px-3 py-2">
                                            <input type="number" asp-for="@Model[i].ChiSoMoi" class="form-control zzz-terminal-input fw-black fs-5 text-center border-dark border-2 rounded-0 shadow-sm mx-auto" placeholder="0" style="max-width: 150px;" />
                                            <span asp-validation-for="@Model[i].ChiSoMoi" class="text-danger fw-bold mt-1 d-block small zzz-text-mono"></span>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-5 bg-light">
                                        <i class="fas fa-database text-muted fs-1 mb-3"></i>
                                        <h5 class="fw-bold zzz-text-mono text-danger">NO_DATA_FOUND // CHƯA CÓ DỮ LIỆU</h5>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}