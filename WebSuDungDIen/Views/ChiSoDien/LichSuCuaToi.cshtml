@model IEnumerable<WebSuDungDIen.Models.ChiSoDien>

@{
    ViewData["Title"] = "Hồ Sơ Điện Năng";

    // Tính toán thông số
    int tongTieuThu = Model?.Sum(x => x.ChiSoMoi - x.ChiSoCu) ?? 0;
    int soKyGhiNhan = Model?.Count() ?? 0;
    int trungBinhThang = soKyGhiNhan > 0 ? (tongTieuThu / soKyGhiNhan) : 0;
}

<div class="corp-wrapper">
    <div class="container py-4 py-md-5">

        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-3" style="border-bottom: 2px solid #eaedf1;">
            <div>
                <h1 class="corp-section-title mb-1">
                    Hồ Sơ Điện Năng
                </h1>
                <p class="text-muted mb-0">Trung tâm theo dõi và phân tích dữ liệu tiêu thụ định kỳ</p>
            </div>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="row g-4 mb-4">

                <div class="col-lg-4">
                    <div class="card h-100 shadow-sm border-0 border-start border-primary border-4">
                        <div class="card-body">
                            <h5 class="text-dark fw-bold border-bottom pb-2 mb-3">Định Danh Khách Hàng</h5>

                            <div class="mb-2">
                                <small class="text-muted fw-bold d-block text-uppercase">Chủ hộ</small>
                                <span class="fs-5 fw-bold text-dark">@(ViewBag.TenKhachHang ?? "[ Đang cập nhật ]")</span>
                            </div>

                            <div class="mb-2">
                                <small class="text-muted fw-bold d-block text-uppercase">Mã Khách Hàng</small>
                                <span class="fs-6 fw-bold text-primary">@(ViewBag.MaKhachHang ?? "[ Đang cập nhật ]")</span>
                            </div>

                            <div>
                                <small class="text-muted fw-bold d-block text-uppercase">Địa chỉ cung cấp</small>
                                <span class="fs-6 text-dark" style="line-height: 1.4;">
                                    @(ViewBag.DiaChiDayDu ?? "Chưa có thông tin địa chỉ cụ thể.")
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="card h-100 shadow-sm border-0 border-start border-danger border-4 bg-light">
                        <div class="card-body d-flex flex-column justify-content-center align-items-center text-center">
                            <h6 class="text-muted fw-bold text-uppercase mb-3">Tổng Điện Tiêu Thụ</h6>
                            <h1 class="display-4 fw-bold text-danger mb-0">@tongTieuThu</h1>
                            <span class="text-muted fw-bold mt-1">kWh</span>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="card h-100 shadow-sm border-0 border-start border-warning border-4 bg-light">
                        <div class="card-body d-flex flex-column justify-content-center align-items-center text-center">
                            <h6 class="text-muted fw-bold text-uppercase mb-3">Mức Trung Bình / Kỳ</h6>
                            <h1 class="display-4 fw-bold text-warning mb-0">@trungBinhThang</h1>
                            <span class="text-muted fw-bold mt-1">kWh / Tháng</span>
                        </div>
                    </div>
                </div>

            </div>

            <div class="card shadow-sm border-0 mb-5">
                <div class="card-header bg-white border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
                    <h5 class="m-0 fw-bold text-dark">Chi Tiết Ghi Nhận</h5>
                    <span class="badge bg-secondary px-3 py-2 fs-6 rounded-pill">Tổng: @soKyGhiNhan kỳ</span>
                </div>

                <div class="card-body p-0 corp-wrapper">
                    <div class="table-responsive">
                        <table class="corp-invoice-table table-hover text-center">
                            <thead>
                                <tr>
                                    <th class="text-start ps-4">Mã Khách Hàng</th>
                                    <th>Kỳ Hóa Đơn</th>
                                    <th>Chỉ Số Cũ</th>
                                    <th>Chỉ Số Mới</th>
                                    <th class="text-end pe-4">Điện Tiêu Thụ</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    int dienTieuThu = item.ChiSoMoi - item.ChiSoCu;

                                    <tr class="@(dienTieuThu > 400 ? "corp-row-danger" : "")">

                                        <td class="text-start ps-4 fw-bold" style="color: #6c757d;">@(ViewBag.MaKhachHang ?? "N/A")</td>

                                        <td class="fw-bold" style="color: #0d6efd;">@item.Thang.ToString("00") / @item.Nam</td>

                                        <td class="text-muted fw-bold fs-6">@item.ChiSoCu</td>

                                        <td class="fw-bolder fs-6" style="color: #212529;">@item.ChiSoMoi</td>

                                        <td class="text-end pe-4">
                                            <span class="badge @(dienTieuThu > 400 ? "bg-danger" : "bg-info text-dark") px-3 py-2 rounded-pill shadow-sm" style="font-size: 0.9rem;">
                                                @dienTieuThu kWh
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer bg-light text-muted py-3 px-4 text-end" style="font-size: 0.85rem;">
                    Hệ Thống Điện Lực
                </div>
            </div>
        }
        else
        {
            <div class="text-center py-5 shadow-sm bg-white rounded border">
                <h3 class="text-dark fw-bold mb-3 mt-4">Chưa có dữ liệu</h3>
                <p class="text-muted mb-4 fs-5">Hồ sơ của bạn hiện chưa có dữ liệu chốt số điện nào được ghi nhận trên hệ thống.</p>
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4 py-2 mb-4">
                    Quay Lại Trang Chủ
                </a>
            </div>
        }

    </div>
</div>
