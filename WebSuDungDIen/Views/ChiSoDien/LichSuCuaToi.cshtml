@model IEnumerable<WebSuDungDIen.Models.ChiSoDien>

@{
    ViewData["Title"] = "Hồ sơ điện năng";
}

<div class="corp-wrapper">
    <div class="container py-4 py-md-5">

        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center mb-4 pb-3" style="border-bottom: 2px solid #eaedf1;">
            <div>
                <h1 class="corp-section-title mb-1">HỒ SƠ ĐIỆN NĂNG</h1>
                <p class="text-muted mb-0">Theo dõi lịch sử tiêu thụ điện định kỳ</p>
            </div>

            <div class="mt-3 mt-lg-0">
                <span class="badge bg-primary fs-6 px-3 py-2 fw-normal" style="border-radius: 8px !important; box-shadow: 0 4px 10px rgba(13, 110, 253, 0.2) !important;">
                    <i class="fas fa-user-circle me-2"></i> @(ViewBag.TenKhachHang ?? User.Identity.Name)
                </span>
            </div>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="card corp-card border-0 mb-5">
                <div class="card-header bg-white border-bottom py-3 px-4 d-flex justify-content-between align-items-center" style="border-color: #eaedf1 !important;">
                    <h5 class="m-0 text-dark fw-bold"><i class="fas fa-history text-primary me-2"></i> Lịch Sử Chốt Số</h5>
                </div>

                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="corp-invoice-table align-middle w-100">
                            <thead class="text-nowrap">
                                <tr>
                                    <th class="text-start ps-4" style="min-width: 150px;">Kỳ Hóa Đơn</th>
                                    <th class="text-center" style="min-width: 120px;">Chỉ Số Cũ</th>
                                    <th class="text-center" style="min-width: 120px;">Chỉ Số Mới</th>
                                    <th class="text-end pe-4" style="min-width: 180px;">Điện Tiêu Thụ</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    int dienTieuThu = item.ChiSoMoi - item.ChiSoCu;
                                    <tr>
                                        <td class="fw-bold text-primary fs-5 ps-4 text-nowrap">
                                            @item.Thang.ToString("00") / @item.Nam
                                        </td>
                                        <td class="text-center text-muted fs-5">@item.ChiSoCu</td>
                                        <td class="text-center text-dark fw-bold fs-5">@item.ChiSoMoi</td>
                                        <td class="text-end pe-4 text-nowrap">
                                            <span class="badge @(dienTieuThu > 400 ? "bg-danger" : "bg-warning text-dark") fs-6 px-3 py-2" style="border-radius: 6px !important;">
                                                <i class="fas fa-bolt me-1"></i> @dienTieuThu kWh
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="card-footer bg-light text-muted text-end border-top-0 py-3 px-4" style="font-size: 0.85rem;">
                    <i class="fas fa-shield-check me-1"></i> Dữ liệu được trích xuất trực tiếp từ hệ thống điện lực quốc gia.
                </div>
            </div>
        }
        else
        {
            <div class="card corp-card p-5 text-center mt-4 border-0" style="background-color: #ffffff;">
                <div class="card-body py-5">
                    <div class="mb-4">
                        <i class="fas fa-folder-open text-muted" style="font-size: 4rem; opacity: 0.5;"></i>
                    </div>
                    <h3 class="text-dark fw-bold mb-3">Chưa có dữ liệu</h3>
                    <p class="text-muted mb-4" style="font-size: 1.1rem;">Hồ sơ của bạn hiện chưa có dữ liệu chốt số điện nào được ghi nhận trên hệ thống.</p>

                    <a asp-controller="Home" asp-action="Index" class="btn corp-btn-primary">
                        <i class="fas fa-arrow-left me-2"></i> Quay Lại Trang Chủ
                    </a>
                </div>
            </div>
        }

    </div>
</div>