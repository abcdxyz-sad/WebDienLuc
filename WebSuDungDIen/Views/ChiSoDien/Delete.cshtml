@model WebSuDungDIen.Models.ChiSoDien

@{
    ViewData["Title"] = "Tiêu hủy bản ghi";
}

<div class="container-fluid p-0" style="max-width: 800px; margin: 0 auto;">

    <div class="alert alert-danger rounded-0 border-dark border-3 p-4 mb-4 position-relative" style="box-shadow: 8px 8px 0px var(--zzz-black);">
        <h1 class="zzz-page-title m-0 fw-bold text-uppercase d-flex align-items-center gap-2">
            <i class="fas fa-exclamation-triangle"></i> CẢNH BÁO HỆ THỐNG
        </h1>
        <p class="m-0 zzz-text-mono mt-2 fw-bold" style="font-size: 1.1rem;">
            Yêu cầu tiêu hủy bản ghi chỉ số điện. Hành động này là vĩnh viễn và không thể khôi phục!
        </p>
    </div>

    <div class="card rounded-0 border-dark border-3 mb-4 bg-white" style="box-shadow: 8px 8px 0px var(--zzz-black);">
        <div class="card-header bg-dark text-white rounded-0 border-bottom border-dark border-3 p-3 d-flex justify-content-between align-items-center">
            <h4 class="m-0 zzz-text-mono fw-bold">BẢN GHI LƯU TRỮ: #@Model.Id</h4>
            <span class="badge bg-danger border border-white zzz-text-mono fs-6">CHỜ XÓA</span>
        </div>

        <div class="card-body p-4 p-md-5">
            <div class="zzz-fieldset border-danger border-2 bg-light mb-0">
                <div class="zzz-fieldset-title bg-danger text-white border-danger border-2">DEL.01 // DỮ LIỆU SẮP BỊ HỦY</div>

                <div class="row g-4 mt-1">
                    <div class="col-md-12">
                        <label class="form-label zzz-cmd-label text-muted small">ĐỊNH DANH ĐẶC VỤ (MÃ KH)</label>
                        <div class="form-control zzz-terminal-input zzz-locked-input text-danger fw-bold fs-5 text-uppercase">
                            #@Model.KhachHangId
                        </div>
                    </div>

                    <div class="col-md-12">
                        <label class="form-label zzz-cmd-label text-muted small">KỲ BÁO CÁO</label>
                        <div class="form-control zzz-terminal-input zzz-locked-input fw-bold fs-5 text-center">
                            Tháng @Model.Thang / @Model.Nam
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label zzz-cmd-label text-muted small">CHỈ SỐ CŨ</label>
                        <div class="form-control zzz-terminal-input zzz-locked-input fw-bold fs-5 text-end">
                            @Model.ChiSoCu
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label zzz-cmd-label text-muted small">CHỈ SỐ MỚI</label>
                        <div class="form-control zzz-terminal-input zzz-locked-input fw-bold fs-5 text-end text-warning bg-dark">
                            @Model.ChiSoMoi
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex gap-3 mt-4">
        <form asp-action="Delete" class="w-50">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger w-100 fs-5 fw-bold py-3 rounded-0 border-dark border-3" style="box-shadow: 4px 4px 0px var(--zzz-black);">
                <i class="fas fa-skull me-2"></i> XÁC NHẬN TIÊU HỦY
            </button>
        </form>

        <a asp-action="Index" class="btn zzz-btn-cancel w-50 fs-5 fw-bold py-3 text-center text-decoration-none d-flex justify-content-center align-items-center">
            <i class="fas fa-undo me-2"></i> RÚT LUI
        </a>
    </div>

</div>