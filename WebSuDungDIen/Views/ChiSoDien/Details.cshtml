@model WebSuDungDIen.Models.KhachHang

@{
    ViewData["Title"] = "Lịch Sử Chỉ Số Điện Tiêu Thụ";

    // 💥 TÀ THUẬT C#: TỰ ĐỘNG PHÂN TÍCH THỐNG KÊ TỪ RAW DATA
    int totalConsumption = 0;
    int avgConsumption = 0;
    int maxConsumption = 0;
    string maxMonthLabel = "CHƯA CÓ DATA";
    string tinhThanh = "CHƯA CẬP NHẬT";
    string phuongXa = "CHƯA CẬP NHẬT";

    if (Model.ChiSoDien != null && Model.ChiSoDien.Any())
    {
        totalConsumption = Model.ChiSoDien.Sum(x => x.ChiSoMoi - x.ChiSoCu);
        avgConsumption = totalConsumption / Model.ChiSoDien.Count;

        var maxRecord = Model.ChiSoDien.OrderByDescending(x => x.ChiSoMoi - x.ChiSoCu).FirstOrDefault();
        if (maxRecord != null)
        {
            maxConsumption = maxRecord.ChiSoMoi - maxRecord.ChiSoCu;
            maxMonthLabel = $"THÁNG {maxRecord.Thang}/{maxRecord.Nam}";
        }
    }

    if (!string.IsNullOrWhiteSpace(Model.DiaChiDayDu))
    {
        // Cắt chuỗi bằng dấu phẩy, dọn dẹp khoảng trắng 2 đầu
        var parts = Model.DiaChiDayDu.Split(',').Select(p => p.Trim()).ToArray();

        // Cục cuối cùng chắc chắn là Tỉnh/Thành phố
        if (parts.Length >= 1) tinhThanh = parts[parts.Length - 1];

        // Cục kế cuối thường là Phường/Xã hoặc Quận/Huyện
        if (parts.Length >= 2) phuongXa = parts[parts.Length - 2];
    }
}

<div class="border-dashed p-3 mb-4 d-flex flex-column flex-lg-row justify-content-between align-items-center flex-wrap gap-3 zzz-command-panel text-center text-lg-start">
    <h1 class="m-0 zzz-page-title border-start border-5 ps-3" style="border-left-color: var(--zzz-primary) !important;">
        [ BẢN GHI ] LỊCH SỬ TIÊU THỤ
    </h1>

    <div class="d-flex align-items-center flex-wrap justify-content-center gap-3">
        <span class="badge text-dark rounded-0 border border-dark border-2 fs-6 zzz-text-mono px-3 py-2 shadow-sm d-none d-md-block"
              style="background-color: var(--zzz-primary); box-shadow: 2px 2px 0px #000 !important;">
            <span class="text-dark zzz-blink-dot">●</span> HỆ THỐNG: TRUY XUẤT THÀNH CÔNG
        </span>
        <a asp-action="Index" class="btn zzz-btn-cancel fw-bold fs-6 px-4 py-2 rounded-0 border border-3 shadow-sm">
            RÚT LUI
        </a>
    </div>
</div>

<div class="row g-3 justify-content-center">

    <div class="col-12 col-xl-11">

        <div class="row g-3 align-items-stretch">

            <div class="col-lg-8">
                <div class="card border-dark border-3 rounded-0 shadow-sm bg-white h-100">

                    <div class="card-header bg-white text-dark border-bottom border-dark border-3 rounded-0 fw-black py-2 px-3 text-uppercase fs-5 d-flex justify-content-between align-items-center">
                        <span>THÔNG TIN KHÁCH HÀNG</span>
                    </div>

                    <div class="card-body p-3 p-md-4 d-flex flex-column justify-content-center">

                        <div class="mb-3">
                            <label class="fw-bold text-muted small text-uppercase mb-0" style="letter-spacing: 1px;">TÊN KHÁCH HÀNG</label>
                            <div class="fs-3 fw-black text-danger border-bottom border-secondary border-opacity-50 pb-1 text-uppercase text-truncate">
                                @Model.TenKh
                            </div>
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-md-4">
                                <label class="fw-bold text-muted small text-uppercase mb-0" style="letter-spacing: 1px;">MÃ KH</label>
                                <div class="fs-5 fw-bold text-dark zzz-text-mono mt-1">
                                    #@Model.MaKh
                                </div>
                            </div>

                            <div class="col-md-4">
                                <label class="fw-bold text-muted small text-uppercase mb-0" style="letter-spacing: 1px;">SỐ ĐIỆN THOẠI</label>
                                <div class="fs-5 fw-bold text-dark zzz-text-mono mt-1">
                                    @(string.IsNullOrEmpty(Model.DienThoai) ? "CHƯA CẬP NHẬT" : Model.DienThoai)
                                </div>
                            </div>

                            <div class="col-md-4">
                                <label class="fw-bold text-muted small text-uppercase mb-0" style="letter-spacing: 1px;">EMAIL</label>
                                <div class="fs-6 fw-bold text-secondary text-truncate mt-1" style="padding-top: 2px;">
                                    @if (Model.User != null && !string.IsNullOrWhiteSpace(Model.User.Email))
                                    {
                                        @Model.User.Email
                                    }
                                    else
                                    {
                                        @:CHƯA LIÊN KẾT
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="row g-2">
                            <div class="col-md-6">
                                <label class="fw-bold text-muted small text-uppercase mb-0" style="letter-spacing: 1px;">TỈNH / THÀNH PHỐ</label>
                                <div class="fs-5 fw-bold text-dark border-bottom border-secondary border-opacity-25 pb-1 mt-1 text-truncate">
                                    @tinhThanh
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label class="fw-bold text-muted small text-uppercase mb-0" style="letter-spacing: 1px;">PHƯỜNG / XÃ / QUẬN</label>
                                <div class="fs-5 fw-bold text-dark border-bottom border-secondary border-opacity-25 pb-1 mt-1 text-truncate">
                                    @phuongXa
                                </div>
                            </div>

                            <div class="col-12 mt-2">
                                <label class="fw-bold text-muted small text-uppercase mb-1" style="letter-spacing: 1px;">ĐỊA CHỈ ĐẦY ĐỦ</label>
                                <div class="border border-dark border-2 bg-light px-3 py-2 fw-bold fs-6 text-dark d-flex align-items-center shadow-sm">
                                    <i class="fas fa-map-marker-alt text-danger me-2 fs-5"></i>
                                    <span class="text-truncate">@Model.DiaChiDayDu</span>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <div class="col-lg-4 d-flex flex-column gap-3">

                <div class="bg-dark text-white p-3 border border-dark border-3 shadow-sm flex-grow-1 d-flex flex-column justify-content-center position-relative overflow-hidden">
                    <div class="zzz-text-mono small text-muted fw-bold mb-1">>_ TỔNG TIÊU THỤ</div>
                    <div class="fs-3 fw-black" style="color: #00ffaa; z-index: 2;">@totalConsumption <span class="fs-6 text-white">kWh</span></div>
                    <i class="fas fa-bolt position-absolute" style="font-size: 4rem; bottom: -5px; right: 5px; opacity: 0.15; z-index: 1;"></i>
                </div>

                <div class="bg-white text-dark p-3 border border-dark border-3 shadow-sm flex-grow-1 d-flex flex-column justify-content-center position-relative overflow-hidden">
                    <div class="zzz-text-mono small text-muted fw-bold mb-1">>_ TRUNG BÌNH KỲ</div>
                    <div class="fs-3 fw-black text-dark" style="z-index: 2;">@avgConsumption <span class="fs-6 text-muted">kWh</span></div>
                    <i class="fas fa-chart-line position-absolute" style="font-size: 4rem; bottom: -5px; right: 5px; opacity: 0.05; z-index: 1;"></i>
                </div>

                <div class="bg-warning text-dark p-3 border border-dark border-3 shadow-sm flex-grow-1 d-flex flex-column justify-content-center position-relative overflow-hidden">
                    <div class="zzz-text-mono small fw-bold mb-1" style="color: rgba(0,0,0,0.6);">>_ ĐỈNH TẢI (@maxMonthLabel)</div>
                    <div class="fs-3 fw-black text-danger" style="z-index: 2;">@maxConsumption <span class="fs-6 text-dark">kWh</span></div>
                    <i class="fas fa-exclamation-triangle position-absolute text-danger" style="font-size: 4rem; bottom: -5px; right: -5px; opacity: 0.2; z-index: 1;"></i>
                </div>

            </div>
        </div>

        <div class="card border-dark border-3 rounded-0 shadow-sm bg-white mt-3">
            <div class="card-header bg-dark text-warning border-bottom border-dark border-3 rounded-0 fw-bold py-2 px-3 zzz-text-mono fs-5 d-flex justify-content-between align-items-center">
                <span>HIS.03 // BẢNG KÊ CHI TIẾT</span>
                <i class="fas fa-list-ol text-muted"></i>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                    <table class="table table-hover table-striped align-middle mb-0 zzz-table">
                        <thead class="table-dark sticky-top" style="z-index: 1;">
                            <tr>
                                <th class="text-center py-2 border-dark border-bottom border-2">KỲ CHỐT</th>
                                <th class="text-start py-2 border-dark border-bottom border-2">NGƯỜI GHI</th>
                                <th class="text-end py-2 border-dark border-bottom border-2">CHỈ SỐ CŨ</th>
                                <th class="text-end text-warning py-2 border-dark border-bottom border-2">CHỈ SỐ MỚI</th>
                                <th class="text-center py-2 border-dark border-bottom border-2">TIÊU THỤ</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.ChiSoDien != null && Model.ChiSoDien.Any())
                            {
                                @foreach (var item in Model.ChiSoDien.Where(x => x != null).OrderByDescending(x => x.Nam).ThenByDescending(x => x.Thang))
                                {
                                    <tr>
                                        <td class="text-center fw-bold text-dark py-2">Tháng @item.Thang / @item.Nam</td>
                                        <td class="text-start py-2 fw-bold text-secondary">
                                            <i class="fas fa-user-edit text-dark me-1"></i>
                                            @(item.NhanVien != null ? item.NhanVien.TenNV : "KHÔNG RÕ")
                                        </td>
                                        <td class="text-end fw-bold text-secondary fs-6">@item.ChiSoCu</td>
                                        <td class="text-end fw-bold text-warning fs-6">@item.ChiSoMoi</td>
                                        <td class="text-center fw-bold py-2">
                                            <span class="badge bg-danger px-2 py-1 rounded-0 border border-dark border-2 shadow-sm">
                                                @(item.ChiSoMoi - item.ChiSoCu) kWh
                                            </span>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="100" class="text-center border-0 p-0">
                                        <div class="d-flex flex-column justify-content-center align-items-center w-100 bg-light" style="min-height: 250px;">
                                            <i class="fas fa-folder-open mb-3 text-secondary opacity-50" style="font-size: 3.5rem;"></i>
                                            <h5 class="fw-bold text-secondary zzz-text-mono text-uppercase m-0">HỒ SƠ TRẮNG // CHƯA CÓ LỊCH SỬ GHI NHẬN</h5>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
</div>