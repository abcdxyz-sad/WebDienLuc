@model WebSuDungDIen.Models.ChiSoDien

@{
    ViewData["Title"] = "Ghi đè chỉ số điện";
}

<div class="border-dashed p-3 mb-4 d-flex justify-content-between align-items-center flex-wrap gap-3 zzz-command-panel">
    <h1 class="m-0 zzz-page-title">
        [ TỆP DỮ LIỆU ] CHỈ SỐ ĐIỆN
    </h1>
    <div class="d-flex align-items-center gap-3">
        <span class="zzz-sys-status text-danger">
            <i class="fas fa-exclamation-triangle"></i> CẢNH BÁO: <span class="zzz-blink-dot zzz-text-yellow">●</span> ĐANG GHI ĐÈ DỮ LIỆU
        </span>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="card position-relative zzz-card-thick rounded-0 border-dark shadow-lg">

            <div class="zzz-hazard-line"></div>

            <div class="card-body p-4 p-md-5 mt-2">
                <form asp-action="Edit" method="post">

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4 zzz-text-mono fw-bold rounded-0"></div>

                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" name="KhachHangId" value="@Model.KhachHangId" />
                    <input type="hidden" asp-for="Thang" />
                    <input type="hidden" asp-for="Nam" />
                    <input type="hidden" asp-for="ChiSoCu" />

                    <div class="zzz-fieldset">
                        <div class="zzz-fieldset-title">CS.01 // ĐỊNH DANH ĐẶC VỤ</div>

                        <div class="row">
                            <div class="col-md-12 mb-3">
                                <label class="form-label zzz-cmd-label">HỒ SƠ KHÁCH HÀNG</label>
                                <input value="@Model.KhachHang?.MaKh - @Model.KhachHang?.TenKh"
                                       class="form-control zzz-terminal-input zzz-locked-input text-uppercase"
                                       readonly tabindex="-1" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label zzz-cmd-label">KỲ BÁO CÁO (THÁNG/NĂM)</label>
                                <input value="@Model.Thang / @Model.Nam"
                                       class="form-control zzz-terminal-input zzz-locked-input text-center fs-5"
                                       readonly tabindex="-1" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label zzz-cmd-label">CHỈ SỐ ĐIỆN CŨ</label>
                                <input value="@Model.ChiSoCu"
                                       class="form-control zzz-terminal-input zzz-locked-input text-end fs-5"
                                       readonly tabindex="-1" />
                            </div>
                        </div>
                    </div>

                    <div class="zzz-fieldset zzz-fieldset-highlight border-dark">
                        <div class="zzz-fieldset-title zzz-fieldset-title-highlight border-dark">CS.02 // GHI ĐÈ CHỈ SỐ</div>

                        <div class="row">
                            <div class="col-md-12 mb-2">
                                <label asp-for="ChiSoMoi" class="form-label zzz-cmd-label text-danger">
                                    <span>NHẬP CHỈ SỐ MỚI</span>
                                    <span class="zzz-text-req zzz-text-danger-req">* LƯU Ý KẾT QUẢ SẼ LÀM THAY ĐỔI HÓA ĐƠN</span>
                                </label>

                                <input asp-for="ChiSoMoi"
                                       class="form-control zzz-terminal-input text-end fs-1 py-3 border-dark border-3"
                                       autocomplete="off" />

                                <span asp-validation-for="ChiSoMoi" class="text-danger zzz-text-danger-req d-block mt-2 zzz-text-mono"></span>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-3 mt-4">
                        <button type="submit" class="btn btn-primary zzz-btn-large flex-grow-1 fw-bold border-dark border-3 rounded-0 shadow-sm">
                            <i class="fas fa-bolt me-2"></i> LƯU GHI ĐÈ
                        </button>

                        <a asp-action="Index" class="btn btn-dark zzz-btn-cancel fw-bold px-5 border-dark border-3 rounded-0 shadow-sm">
                            <i class="fas fa-undo me-2"></i> RÚT LUI
                        </a>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            var inputChiSoMoi = document.getElementById("ChiSoMoi");
            if(inputChiSoMoi) {
                inputChiSoMoi.focus();
                inputChiSoMoi.select();
            }
        });
    </script>
}