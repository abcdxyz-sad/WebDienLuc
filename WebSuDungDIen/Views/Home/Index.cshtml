@{
    ViewData["Title"] = "Trang Chủ - Điện Lực";
}

<link rel="stylesheet" href="~/css/home-enterprise.css" />

@if (TempData["ThongBao"] != null)
{
    <div class="container mt-3">
        <div class="erp-alert">
            <i class="fas fa-info-circle me-2"></i> @TempData["ThongBao"]
        </div>
    </div>
}

@if (User.Identity?.IsAuthenticated == true && (User.IsInRole("Admin") || User.IsInRole("NhanVien")))
{
    <div class="erp-hero-section" style="padding: 4rem 0 6rem 0;">
        <div class="container erp-hero-content">
            <div class="row align-items-center">
                <div class="col-lg-7">
                    <div class="erp-badge mb-3 bg-danger text-white border-0" style="box-shadow: 2px 2px 0 #000;">KHU VỰC NỘI BỘ</div>
                    <h1 class="erp-title">Nền tảng số hóa<br /><span class="text-highlight">Nghiệp vụ Phân phối</span></h1>
                    <p class="erp-subtitle text-white">Xin chào<strong>@User.Identity.Name</strong>. Chọn phân hệ bên dưới để bắt đầu phiên làm việc.</p>
                </div>
                <div class="col-lg-5 d-none d-lg-block text-end">
                    <div class="erp-hero-visual" style="min-height: 200px;">
                        <div class="visual-card">
                            <i class="fas fa-server text-primary mb-2" style="font-size: 2rem;"></i>
                            <h6 class="mb-0 text-white">Máy chủ lõi</h6>
                            <span class="text-success small">● Đang hoạt động</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="container erp-stats-container">
        <div class="row g-0 erp-stats-wrapper">
            <div class="col-md-3 col-6 erp-stat-box">
                <h4><i class="fas fa-users text-primary"></i></h4>
                <p>Khách hàng</p>
            </div>
            <div class="col-md-3 col-6 erp-stat-box">
                <h4><i class="fas fa-bolt text-primary"></i></h4>
                <p>Chỉ số điện</p>
            </div>
            <div class="col-md-3 col-6 erp-stat-box">
                <h4><i class="fas fa-file-invoice text-primary"></i></h4>
                <p>Hóa đơn xuất</p>
            </div>
            <div class="col-md-3 col-6 erp-stat-box border-0">
                <h4><i class="fas fa-shield-alt text-primary"></i></h4>
                <p>Bảo mật Cấp 4</p>
            </div>
        </div>
    </div>

    <div class="container erp-main-content">
        <div class="row">
            <div class="col-lg-8 mb-4">
                <h3 class="erp-section-title">PHÂN HỆ NGHIỆP VỤ LÕI</h3>
                <p class="text-muted mb-4">Click vào module tương ứng để thực hiện thao tác nghiệp vụ.</p>

                <div class="row g-4">
                    <div class="col-md-6">
                        <a href="/KhachHang" class="erp-module-card text-decoration-none">
                            <div class="module-icon"><i class="fas fa-users"></i></div>
                            <div class="module-info">
                                <h5>Hồ Sơ Khách Hàng</h5>
                                <p>Quản lý định danh, hợp đồng và địa bàn tiêu thụ điện.</p>
                            </div>
                        </a>
                    </div>
                    <div class="col-md-6">
                        <a href="/ChiSoDien" class="erp-module-card text-decoration-none">
                            <div class="module-icon bg-dark text-white"><i class="fas fa-tachometer-alt"></i></div>
                            <div class="module-info">
                                <h5>Cập Nhật Chỉ Số</h5>
                                <p>Nhập liệu và đối soát chỉ số công tơ định kỳ hàng tháng.</p>
                            </div>
                        </a>
                    </div>
                    <div class="col-md-6">
                        <a href="/HoaDon" class="erp-module-card text-decoration-none highlight-card">
                            <div class="module-icon" style="background-color: var(--zzz-black); color: var(--zzz-primary);"><i class="fas fa-file-invoice-dollar"></i></div>
                            <div class="module-info">
                                <h5>Quản Trị Hóa Đơn</h5>
                                <p>Tính toán tiền điện tự động, áp thuế và xuất biên lai.</p>
                            </div>
                        </a>
                    </div>
                    <div class="col-md-6">
                        <a href="/DonGiaDien" class="erp-module-card text-decoration-none">
                            <div class="module-icon text-dark" style="background-color: #eee;"><i class="fas fa-sliders-h"></i></div>
                            <div class="module-info">
                                <h5>Chính Sách Giá</h5>
                                <p>Cấu hình tham số 6 bậc điện sinh hoạt theo chuẩn nhà nước.</p>
                            </div>
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <h3 class="erp-section-title">TRẠNG THÁI SERVER</h3>
                <div class="erp-side-panel mb-4">
                    <ul class="server-status-list">
                        <li>
                            <span>Database SQL</span>
                            <span class="badge bg-success">Kết nối tốt</span>
                        </li>
                        <li>
                            <span>MongoDB Backup</span>
                            <span class="badge bg-success">Đồng bộ</span>
                        </li>
                        <li>
                            <span>API Gateway</span>
                            <span class="badge text-dark" style="background-color: var(--zzz-primary);">Ổn định</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
}
else
{
    @* =========================================================================
       GIAO DIỆN KHÁCH HÀNG - PHIÊN BẢN "ENERGY CYBER" (KÍNH MỜ + GLOWING + ANIMATION)
       ========================================================================= *@

    <div class="corp-wrapper">
        <div class="corp-customer-home">

            <div class="position-relative overflow-hidden rounded-bottom-5 hero-section">

                <div class="position-absolute w-100 h-100 top-0 start-0 hero-overlay"></div>

                <div class="position-absolute top-50 start-0 translate-middle hero-bg-icon">
                    <i class="fas fa-bolt text-primary"></i>
                </div>

                <div class="container position-relative z-index-1">
                    <div class="row justify-content-center">
                        <div class="col-lg-10 text-center">

                            <div class="p-4 p-md-5 floating-element glass-card">

                                <span class="badge mb-3 px-4 py-2 rounded-pill fw-bold text-uppercase border border-primary border-opacity-25 badge-custom">
                                    <i class="fas fa-leaf me-1 text-success"></i> Năng lượng xanh & Bền vững
                                </span>

                                <h1 class="display-3 fw-bolder mb-3 hero-title">
                                    CÔNG TY ĐIỆN LỰC
                                </h1>

                                <p class="lead mx-auto mb-0 hero-subtitle">
                                    Kiến tạo lưới điện thông minh. Trải nghiệm dịch vụ nhanh chóng, minh bạch và an toàn tuyệt đối ngay trên thiết bị của bạn.
                                </p>

                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="container overlap-container">
                <div class="row g-4 justify-content-center">
                    <div class="col-md-4">
                        <div class="card border-0 shadow-lg rounded-4 h-100 bg-white hover-lift-glow">
                            <div class="card-body text-center p-4">
                                <div class="bg-warning bg-opacity-10 text-warning rounded-circle d-inline-flex align-items-center justify-content-center mb-3 shadow-sm icon-box-md">
                                    <i class="fas fa-headset fs-3"></i>
                                </div>
                                <h5 class="fw-bold text-dark mb-1">1900 100 Có</h5>
                                <p class="text-muted small mb-0">Hỗ trợ khẩn cấp 24/7</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card border-0 shadow-lg rounded-4 h-100 bg-white hover-lift-glow">
                            <div class="card-body text-center p-4">
                                <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-3 shadow-sm icon-box-md">
                                    <i class="fas fa-shield-alt fs-3"></i>
                                </div>
                                <h5 class="fw-bold text-dark mb-1">Mã Hóa 256-bit</h5>
                                <p class="text-muted small mb-0">Bảo mật thông tin tuyệt đối</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="container mt-5 pt-4">
                <h3 class="fw-bolder text-dark mb-4 text-center section-title">
                    <span class="text-primary">|</span> TRUNG TÂM DỊCH VỤ <span class="text-primary">|</span>
                </h3>

                <div class="row g-4">
                    <div class="col-lg-8">
                        <div class="row g-4 mb-4">
                            <div class="col-md-6">
                                <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden bg-white hover-lift-glow border-bottom border-primary border-4">
                                    <div class="card-body p-4 p-md-5 position-relative">
                                        <i class="fas fa-file-invoice-dollar position-absolute opacity-10 card-icon-huge card-icon-blue"></i>
                                        <div class="d-inline-block bg-primary bg-opacity-10 p-3 rounded-3 mb-4">
                                            <i class="fas fa-search fs-4 text-primary"></i>
                                        </div>
                                        <h4 class="fw-bold text-dark mb-3">Tra cứu Hóa đơn</h4>
                                        <p class="text-muted mb-4">Theo dõi chi tiết số tiền điện, đối chiếu công nợ và thanh toán trực tuyến chỉ với 1 chạm.</p>
                                        <a asp-area="" asp-controller="KhachHang" asp-action="TienDienThangNay" class="btn corp-btn-primary fw-bold rounded-pill px-4 stretched-link shadow-sm">
                                            Truy cập ngay <i class="fas fa-arrow-right ms-1"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden bg-white hover-lift-glow border-bottom border-success border-4">
                                    <div class="card-body p-4 p-md-5 position-relative">
                                        <i class="fas fa-chart-line position-absolute opacity-10 card-icon-huge card-icon-green"></i>
                                        <div class="d-inline-block bg-success bg-opacity-10 p-3 rounded-3 mb-4">
                                            <i class="fas fa-history fs-4 text-success"></i>
                                        </div>
                                        <h4 class="fw-bold text-dark mb-3">Lịch sử Chỉ số</h4>
                                        <p class="text-muted mb-4">Phân tích biểu đồ điện năng tiêu thụ qua các tháng để tối ưu hóa chi phí sinh hoạt.</p>
                                        <a asp-area="" asp-controller="DichVu" asp-action="SuDungDien" class="btn btn-success fw-bold rounded-pill px-4 stretched-link shadow-sm">
                                            Phân tích <i class="fas fa-chart-bar ms-1"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white hover-lift-glow border-start border-danger border-5">
                            <div class="card-body p-4">
                                <div class="row align-items-center text-center text-md-start">
                                    <div class="col-md-auto mb-3 mb-md-0 d-flex justify-content-center">
                                        <div class="bg-danger bg-opacity-10 text-danger rounded-circle d-flex align-items-center justify-content-center shadow-sm icon-box-lg">
                                            <i class="fas fa-bolt fs-2"></i>
                                        </div>
                                    </div>
                                    <div class="col mb-3 mb-md-0">
                                        <h5 class="fw-bold text-dark mb-2">Báo cáo Sự cố Điện lưới</h5>
                                        <p class="text-muted mb-0 text-sm-custom">Mất điện đột ngột? Đội phản ứng nhanh của chúng tôi luôn sẵn sàng 24/7.</p>
                                    </div>
                                    <div class="col-md-auto mt-2 mt-md-0">
                                        <button class="btn btn-danger btn-pulse-danger fw-bold rounded-pill px-4 py-3 text-uppercase shadow-sm w-100" onclick="alert('Kết nối đường dây nóng...')">
                                            <i class="fas fa-exclamation-triangle me-2"></i> Báo sự cố
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <div class="card border-0 shadow-lg rounded-4 text-white h-100 position-relative overflow-hidden hover-lift-glow app-banner">
                            <div class="position-absolute bg-white opacity-10 rounded-circle floating-element app-banner-circle"></div>

                            <div class="card-body p-4 p-xl-5 d-flex flex-column justify-content-center text-center position-relative z-index-1">
                                <div class="mb-4 floating-element delay-1s">
                                    <div class="d-inline-flex align-items-center justify-content-center bg-white bg-opacity-25 rounded-4 shadow-sm position-relative qr-container">
                                        <i class="fas fa-qrcode text-white fs-1"></i>
                                    </div>
                                </div>

                                <h3 class="fw-bolder mb-3 text-gradient">Siêu Ứng Dụng</h3>
                                <p class="text-white mb-4 app-desc">
                                    Quét mã để cài đặt. Trải nghiệm hệ sinh thái điện lực số toàn diện nhất hiện nay.
                                </p>

                                <div class="d-grid gap-3 mt-auto">
                                    <button class="btn btn-store text-white rounded-3 shadow py-2 px-3 border border-secondary border-opacity-50" onclick="alert('Chuyển hướng App Store')">
                                        <div class="d-flex align-items-center justify-content-center">
                                            <i class="fab fa-apple fs-2 me-2"></i>
                                            <div class="text-start lh-1">
                                                <span class="d-block store-subtitle">Download on the</span>
                                                <span class="fw-bold fs-5">App Store</span>
                                            </div>
                                        </div>
                                    </button>
                                    <button class="btn btn-store text-white rounded-3 shadow py-2 px-3 border border-secondary border-opacity-50" onclick="alert('Chuyển hướng Google Play')">
                                        <div class="d-flex align-items-center justify-content-center">
                                            <i class="fab fa-google-play fs-2 me-2 text-info"></i>
                                            <div class="text-start lh-1">
                                                <span class="d-block store-subtitle">GET IT ON</span>
                                                <span class="fw-bold fs-5">Google Play</span>
                                            </div>
                                        </div>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>
}