@model IEnumerable<WebSuDungDIen.ViewModels.LichSuGiaoDichVM>

@{
    ViewData["Title"] = "Lịch Sử Giao Dịch";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4 p-4 bg-white rounded-4 shadow-sm border-0">
    <h2 class="m-0 fw-bold text-primary d-flex align-items-center fs-4">
        <span class="bg-primary bg-opacity-10 p-3 rounded-circle me-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
            <i class="fas fa-file-invoice-dollar text-primary fs-5"></i>
        </span>
        Lịch sử thanh toán
    </h2>

    <div class="d-flex align-items-center gap-3 flex-wrap">
        <a asp-controller="KhachHang" asp-action="TienDienThangNay" class="btn btn-light border fw-bold fs-6 px-4 py-2 rounded-pill hover-shadow transition-all text-secondary">
            <i class="fas fa-arrow-left me-2"></i> Quay lại
        </a>
    </div>
</div>

<div class="card border-0 rounded-4 shadow-sm mb-5 p-4">
    <div class="d-flex justify-content-between align-items-end border-bottom pb-3 mb-4">
        <h5 class="fw-bold text-secondary m-0">
            <i class="fas fa-stream me-2"></i> Chi tiết các khoản giao dịch
        </h5>
        <span class="text-muted" style="font-size: 0.85rem;">Hiển thị gần đây nhất</span>
    </div>

    <div class="timeline-container ps-2 ps-md-4">
        @if (Model != null && Model.Any())
        {
            int loopIndex = 0; // Biến đếm để phân biệt dòng đầu tiên (mới nhất) và các dòng cũ

            foreach (var item in Model)
            {
                bool isNewest = (loopIndex == 0); // Dòng đầu tiên là mới nhất

                <div class="timeline-item position-relative mb-4">

                    <div class="timeline-marker bg-white border border-3 @(isNewest ? "border-primary" : "border-secondary border-opacity-25") d-flex align-items-center justify-content-center shadow-sm">
                        @if (isNewest)
                        {
                            <div class="pulse-dot bg-primary rounded-circle" style="width: 10px; height: 10px;"></div>
                        }
                        else
                        {
                            <div class="bg-secondary opacity-50 rounded-circle" style="width: 8px; height: 8px;"></div>
                        }
                    </div>

                    <div class="timeline-content bg-white rounded-4 shadow-sm border transition-all ms-4 overflow-hidden">

                        <div class="p-3 p-md-4">
                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                                <div class="d-flex align-items-center gap-3">

                                    @if (item.TrangThaiThanhCong)
                                    {
                                        <div class="bg-success bg-opacity-10 text-success rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 50px; height: 50px;">
                                            <i class="fas fa-check fs-4"></i>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="bg-danger bg-opacity-10 text-danger rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 50px; height: 50px;">
                                            <i class="fas fa-times fs-4"></i>
                                        </div>
                                    }

                                    <div>
                                        <h5 class="fw-bold text-dark mb-1" style="font-size: 1.1rem;">Thanh toán tiền điện @item.ThangNamHoaDon</h5>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-50 rounded-pill px-2 py-1" style="font-size: 0.7rem;">
                                                @item.TheLoaiGiaoDich
                                            </span>
                                            <span class="text-muted" style="font-size: 0.85rem;"><i class="far fa-clock me-1"></i>@item.NgayGiaoDich.ToString("HH:mm - dd/MM/yyyy")</span>
                                        </div>
                                    </div>
                                </div>

                                <div class="text-md-end ms-auto">
                                    <h4 class="fw-bold text-danger mb-0">@item.SoTien.ToString("N0") <span class="fs-6 text-muted">đ</span></h4>
                                </div>
                            </div>
                        </div>

                        <div class="bg-light border-top px-3 px-md-4 py-2 d-flex justify-content-between align-items-center flex-wrap gap-2" style="font-size: 0.85rem;">
                            <div class="text-muted">
                                <i class="fas fa-barcode me-1"></i> Mã GD: <span class="fw-bold text-dark">@item.MaGiaoDich</span>
                            </div>

                            <div class="d-flex align-items-center gap-2">
                                @if (item.PhuongThuc != null && item.PhuongThuc.Trim().ToUpper() == "QR")
                                {
                                    <span class="fw-semibold text-primary">
                                        <i class="fas fa-qrcode me-1"></i> QUÉT MÃ QR
                                    </span>
                                }
                                else
                                {
                                    <span class="fw-semibold text-success">
                                        <i class="fas fa-hand-pointer me-1"></i> THANH TOÁN TRỰC TIẾP
                                    </span>
                                }

                                <span class="text-muted mx-1">|</span>

                                @if (item.TrangThaiThanhCong)
                                {
                                    <span class="text-success fw-bold"><i class="fas fa-check-circle me-1"></i> Thành công</span>
                                }
                                else
                                {
                                    <span class="text-danger fw-bold"><i class="fas fa-times-circle me-1"></i> Thất bại</span>
                                }
                            </div>
                        </div>

                    </div>
                </div>

                loopIndex++; // Tăng biến đếm lên cho các vòng lặp sau
            }
        }
        else
        {
            <div class="text-center py-5">
                <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 100px; height: 100px;">
                    <i class="fas fa-receipt fs-1 text-muted opacity-50"></i>
                </div>
                <h5 class="fw-bold text-secondary mb-1">Chưa có giao dịch nào</h5>
                <p class="text-muted" style="font-size: 0.9rem;">Bạn chưa thực hiện bất kỳ khoản thanh toán nào trên hệ thống.</p>
            </div>
        }
    </div>
</div>

<style>
    /* Trục dọc của timeline */
    .timeline-container {
        position: relative;
        padding-left: 1rem;
    }

        .timeline-container::before {
            content: '';
            position: absolute;
            top: 0;
            bottom: 0;
            left: 2rem;
            width: 2px; /* Thu nhỏ trục dọc lại một chút cho tinh tế */
            background-color: #e9ecef;
            z-index: 0;
        }

    @@media (max-width: 767.98px) {
        .timeline-container::before {
            left: 1.25rem;
        }
    }

    /* Các thẻ chứa nội dung + Hiệu ứng Fade-in (Cascade) */
    .timeline-item {
        position: relative;
        z-index: 1;
        animation: fadeUp 0.5s ease-out forwards;
        opacity: 0;
        transform: translateY(20px);
    }

        .timeline-item:nth-child(1) {
            animation-delay: 0.1s;
        }

        .timeline-item:nth-child(2) {
            animation-delay: 0.2s;
        }

        .timeline-item:nth-child(3) {
            animation-delay: 0.3s;
        }

        .timeline-item:nth-child(4) {
            animation-delay: 0.4s;
        }

        .timeline-item:nth-child(5) {
            animation-delay: 0.5s;
        }

    @@keyframes fadeUp {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Điểm đánh dấu (Cái nút tròn nhỏ nhắn) */
    .timeline-marker {
        position: absolute;
        top: 30px;
        left: -10px; /* Căn lại cho khớp với trục dọc */
        width: 24px;
        height: 24px;
        border-radius: 50%;
        z-index: 2;
        box-shadow: 0 0 0 6px #fff;
    }

    @@media (max-width: 767.98px) {
        .timeline-marker {
            top: 25px;
            left: -15px;
        }
    }

    /* Hiệu ứng nhấp nháy cho giao dịch mới nhất */
    .pulse-dot {
        box-shadow: 0 0 0 0 rgba(13, 110, 253, 0.7);
        animation: pulsing 1.5s infinite;
    }

    @@keyframes pulsing {
        0% {
            transform: scale(0.95);
            box-shadow: 0 0 0 0 rgba(13, 110, 253, 0.7);
        }

        70% {
            transform: scale(1);
            box-shadow: 0 0 0 10px rgba(13, 110, 253, 0);
        }

        100% {
            transform: scale(0.95);
            box-shadow: 0 0 0 0 rgba(13, 110, 253, 0);
        }
    }

    /* Thẻ nội dung (Card) */
    .timeline-content {
        margin-left: 3rem;
        border: 2px solid #e9ecef !important;
        box-shadow: 0 4px 10px rgba(0,0,0,0.02) !important;
    }

    @@media (max-width: 767.98px) {
        .timeline-content {
            margin-left: 1.5rem;
        }
    }

    /* Hover effect */
    .timeline-content:hover {
        transform: translateY(-3px);
        box-shadow: 0 12px 25px rgba(0,123,255,0.08) !important;
        border-color: #0d6efd !important;
    }
</style>
