@model WebSuDungDIen.Models.KhachHang

@{
    ViewData["Title"] = "XÓA KHÁCH HÀNG";
}

<div class="container-fluid p-0" style="max-width: 800px; margin: 0 auto;">

    <div class="border border-danger border-4 bg-danger text-white p-4 mb-4 position-relative" style="box-shadow: 8px 8px 0px var(--zzz-black);">
        <h1 class="zzz-page-title m-0 fw-bold text-uppercase d-flex align-items-center gap-2">
            <i class="fas fa-exclamation-triangle"></i> CẢNH BÁO HỆ THỐNG
        </h1>
        <p class="m-0 zzz-text-mono mt-2 fw-bold" style="font-size: 1.1rem;">
            YÊU CẦU TIÊU HỦY HỒ SƠ KHÁCH HÀNG. HÀNH ĐỘNG NÀY LÀ VĨNH VIỄN VÀ KHÔNG THỂ KHÔI PHỤC!
        </p>
    </div>

    <div class="card rounded-0 border-dark border-3 mb-4 bg-white" style="box-shadow: 8px 8px 0px var(--zzz-black);">
        <div class="card-header bg-dark text-white rounded-0 border-bottom border-dark border-3 p-3 d-flex justify-content-between align-items-center">
            <h4 class="m-0 zzz-text-mono text-white fw-bold">MÃ KHÁCH: #@Model.MaKh</h4>
            <span class="badge bg-danger border border-white zzz-text-mono fs-6">CHỜ XÓA</span>
        </div>

        <div class="card-body p-4">
            <div class="row g-4">

                <div class="col-md-12">
                    <label class="zzz-text-mono text-muted small fw-bold text-uppercase">Tên Khách hàng / Đại diện</label>
                    <div class="zzz-text-name fs-4 border-bottom border-dark border-2 pb-1 text-danger">
                        @Html.DisplayFor(model => model.TenKh)
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="zzz-text-mono text-muted small fw-bold text-uppercase">Tài khoản Hệ Thống (User ID)</label>
                    <div class="zzz-text-mono fw-bold fs-6">
                        @Html.DisplayFor(model => model.MaKh)
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="zzz-text-mono text-muted small fw-bold text-uppercase">Số điện thoại</label>
                    <div class="zzz-badge-id fs-5 fw-bold text-end text-md-start">
                        @Html.DisplayFor(model => model.DienThoai)
                    </div>
                </div>

                <div class="col-md-12">
                    <label class="zzz-text-mono text-muted small fw-bold text-uppercase">Địa chỉ</label>
                    <div class="fw-bold fs-6 border p-2 bg-light border-dark">
                        <i class="fas fa-map-marker-alt text-danger me-2"></i> @Html.DisplayFor(model => model.DiaChiDayDu)
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex gap-3 mt-4">
        <form asp-action="Delete" class="w-50">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn w-100 btn-danger zzz-btn-danger fs-5 fw-bold py-3 rounded-0 border-dark border-3" style="box-shadow: 4px 4px 0px var(--zzz-black);">
                <i class="fas fa-skull me-2"></i> XÁC NHẬN TIÊU HỦY
            </button>
        </form>

        <a asp-action="Index" class="btn w-50 zzz-btn-cancel fs-5 fw-bold py-3 text-center d-flex justify-content-center align-items-center">
            <i class="fas fa-undo me-2"></i> RÚT LUI
        </a>
    </div>

</div>