@model IEnumerable<WebSuDungDIen.ViewModels.LichSuDonGiaVM>

@{
    ViewData["Title"] = "Niêm yết Đơn giá điện";
}

<style>
    /* --- TIMELINE --- */
    .zzz-timeline-container {
        position: relative;
        padding-left: 2.5rem;
        border-left: 4px dashed var(--zzz-black, #000); /* Dùng biến đen của sếp */
        margin-left: 1rem;
        padding-bottom: 2rem;
    }

    .zzz-timeline-node {
        position: absolute;
        left: -14px;
        top: 1.5rem;
        width: 24px;
        height: 24px;
        border: 4px solid var(--zzz-black, #000);
        border-radius: 50%;
        box-shadow: 0 0 0 4px #fff;
        z-index: 2;
    }

    /* Màu vàng chanh cho cục Node hiện tại */
    .node-active {
        background-color: #ccff00 !important;
    }

    /* Màu xám cho cục Node lịch sử cũ */
    .node-archived {
        background-color: #e9ecef !important;
    }

    .zzz-timeline-year {
        position: absolute;
        left: -6rem;
        top: 1.3rem;
        font-weight: 900;
        font-size: 1.2rem;
        color: var(--zzz-black, #000);
        background: #f8f9fa;
        padding: 2px 5px;
        border: var(--zzz-border);
        font-family: monospace;
    }
</style>

<div class="border-dashed p-3 p-lg-4 mb-4 d-flex flex-column flex-lg-row justify-content-between align-items-center gap-3 zzz-command-panel border-dark border-3 bg-white">
    <div class="d-flex align-items-center gap-3">
        <h1 class="m-0 zzz-page-title fw-bold text-uppercase fs-3 fs-lg-2 border-start border-primary border-5 ps-3 text-nowrap d-inline-block"
            style="border-left-color: var(--zzz-primary) !important; letter-spacing: 1px;"
            data-intro="Chào mừng đến với khu vực quản lý nhân viên!"
            data-step="1">
            NIÊM YẾT ĐƠN GIÁ ĐIỆN LỰC
        </h1>
    </div>

    <div class="text-end">
        <span class="badge bg-white text-dark p-2 fs-6" style="border: var(--zzz-border); box-shadow: 2px 2px 0px #000;">
            <i class="fas fa-filter text-danger me-1"></i> HIỂN THỊ BẢN GHI MỚI NHẤT
        </span>
    </div>
</div>

<div class="ms-3 ms-md-5">
    @if (Model != null && Model.Any())
    {
        var latestDate = Model.First().NgayNhapLanDau;

        <div class="zzz-timeline-container">
            @foreach (var item in Model)
            {
                bool isLatest = item.NgayNhapLanDau == latestDate;

                <div class="zzz-timeline-node @(isLatest ? "node-active" : "node-archived")"></div>
                <div class="zzz-timeline-year d-none d-md-block">@item.NgayNhapLanDau.ToString("yyyy")</div>

                <div class="card @(isLatest ? "" : "opacity-75")">
                    <div class="card-header py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div class="d-flex align-items-center gap-3">
                            <i class="fas fa-calendar-check fs-3"></i>
                            <div>
                                <h4 class="m-0 fw-black zzz-text-mono" style="letter-spacing: 1px;">
                                    HIỆU LỰC TỪ: @item.NgayNhapLanDau.ToString("dd/MM/yyyy - HH:mm")
                                </h4>
                                @if (isLatest)
                                {
                                    <small class="text-danger fw-bold"><i class="fas fa-broadcast-tower zzz-blink-dot me-1"></i>ĐANG LÀM CHUẨN TÍNH TIỀN THÁNG HIỆN TẠI</small>
                                }
                            </div>
                        </div>
                        <div>
                            @if (isLatest)
                            {
                                <span class="badge bg-dark fs-5 py-2 px-3 shadow-sm zzz-text-mono" style="color:var(--zzz-primary) !important; border: var(--zzz-border);">
                                    [ ACTIVE ] ĐANG ÁP DỤNG
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary text-light fs-6 py-2 px-3 zzz-text-mono" style="border: var(--zzz-border);">
                                    [ ARCHIVED ] LỊCH SỬ CŨ
                                </span>
                            }
                        </div>
                    </div>

                    <div class="card-body p-3 p-xl-4 bg-white">
                        <div class="row g-2 g-xl-3">
                            <div class="col-6 col-md-4 col-xl-2">
                                <div class="p-2 p-xl-3 h-100 text-center bg-white position-relative overflow-hidden" style="border: var(--zzz-border); box-shadow: 3px 3px 0px #000;">
                                    <div class="badge text-white mb-2 fs-6 rounded-0 w-100">BẬC 1</div>
                                    <div class="text-muted small fw-bold mb-1">(0 - 50)</div>
                                    <h4 class="fw-black text-success m-0">@item.Gia1.ToString("N0") <small class="text-muted fs-6">đ</small></h4>
                                </div>
                            </div>
                            <div class="col-6 col-md-4 col-xl-2">
                                <div class="p-2 p-xl-3 h-100 text-center bg-white position-relative overflow-hidden" style="border: var(--zzz-border); box-shadow: 3px 3px 0px #000;">
                                    <div class="badge text-white mb-2 fs-6 rounded-0 w-100">BẬC 2</div>
                                    <div class="text-muted small fw-bold mb-1">(51 - 100)</div>
                                    <h4 class="fw-black text-success m-0">@item.Gia2.ToString("N0") <small class="text-muted fs-6">đ</small></h4>
                                </div>
                            </div>
                            <div class="col-6 col-md-4 col-xl-2">
                                <div class="p-2 p-xl-3 h-100 text-center bg-white position-relative overflow-hidden" style="border: var(--zzz-border); box-shadow: 3px 3px 0px #000;">
                                    <div class="badge text-white mb-2 fs-6 rounded-0 w-100">BẬC 3</div>
                                    <div class="text-muted small fw-bold mb-1">(101 - 200)</div>
                                    <h4 class="fw-black text-primary m-0">@item.Gia3.ToString("N0") <small class="text-muted fs-6">đ</small></h4>
                                </div>
                            </div>
                            <div class="col-6 col-md-4 col-xl-2">
                                <div class="p-2 p-xl-3 h-100 text-center bg-white position-relative overflow-hidden" style="border: var(--zzz-border); box-shadow: 3px 3px 0px #000;">
                                    <div class="badge text-white mb-2 fs-6 rounded-0 w-100">BẬC 4</div>
                                    <div class="text-muted small fw-bold mb-1">(201 - 300)</div>
                                    <h4 class="fw-black text-warning m-0">@item.Gia4.ToString("N0") <small class="text-muted fs-6">đ</small></h4>
                                </div>
                            </div>
                            <div class="col-6 col-md-4 col-xl-2">
                                <div class="p-2 p-xl-3 h-100 text-center position-relative overflow-hidden" style="background-color: #fffbdd; border: var(--zzz-border); box-shadow: 3px 3px 0px #000;">
                                    <div class="badge mb-2 fs-6 rounded-0 w-100" style="background-color: #000 !important; color: #ffffff !important;">BẬC 5</div>
                                    <div class="text-muted small fw-bold mb-1">(301 - 400)</div>
                                    <h4 class="fw-black text-dark m-0">@item.Gia5.ToString("N0") <small class="text-muted fs-6">đ</small></h4>
                                </div>
                            </div>
                            <div class="col-6 col-md-4 col-xl-2">
                                <div class="p-2 p-xl-3 h-100 text-center position-relative overflow-hidden" style="background-color: #ffeded; border: var(--zzz-border); box-shadow: 3px 3px 0px #000;">
                                    <div class="badge bg-danger text-white mb-2 fs-6 rounded-0 w-100" style="border: var(--zzz-border);">BẬC 6 MAX</div>
                                    <div class="text-danger small fw-bold mb-1">(Từ 401)</div>
                                    <h4 class="fw-black text-danger m-0">@item.Gia6.ToString("N0") <small class="text-dark fs-6">đ</small></h4>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5 ms-md-4 mt-3" style="border: var(--zzz-border); box-shadow: 7px 7px 0px #000; background-color: var(--zzz-surface);">
            <i class="fas fa-server mb-3 text-secondary" style="font-size: 4rem;"></i>
            <h2 class="fw-black text-muted" style="color: var(--zzz-black) !important;">HỆ THỐNG TRẮNG</h2>
            <p class="text-muted fs-5">Chưa có quyết định ban hành Đơn Giá Điện nào được lưu trữ.</p>
        </div>
    }
</div>