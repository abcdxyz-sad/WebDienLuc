@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
    <title>Thanh Toán An Toàn | Proxy Power</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
     <link rel="stylesheet" href="~/css/Mobile.css" /> 
</head>
<body>

    <div id="paymentScreen" class="fintech-wrapper">

        <div class="text-center mb-3 text-muted small fw-semibold">
            <i class="fas fa-lock text-success me-1"></i> Môi trường thanh toán an toàn
        </div>

        <div class="fintech-card">
            <div class="fintech-header">
                <div class="mb-2 opacity-75 small text-uppercase tracking-wider">Tổng tiền thanh toán</div>
                <div class="amount-display mb-1">
                    @string.Format("{0:N0}", ViewBag.TongThanhToan ?? 0) <span class="fs-4 fw-normal">VNĐ</span>
                </div>
                <div class="opacity-75 small">*(Đã bao gồm VAT)*</div>
            </div>

            <div class="card-body px-4 pt-1 pb-4">
                <h6 class="fw-bold text-dark mb-3 mt-4">Thông tin giao dịch</h6>

                <div class="detail-row">
                    <span class="text-muted small">Mã hóa đơn</span>
                    <span class="fw-bold text-dark">@ViewBag.MaHd</span>
                </div>

                <div class="detail-row">
                    <span class="text-muted small">Mã khách hàng</span>
                    <span class="fw-bold text-primary font-monospace">@ViewBag.MaKh</span>
                </div>
                <div class="detail-row">
                    <span class="text-muted small">Điện năng tiêu thụ</span>
                    <span class="fw-bold text-danger">@ViewBag.SoDien <small class="text-muted fw-normal">kWh</small></span>
                </div>
                <div class="detail-row">
                    <span class="text-muted small">Kỳ cước</span>
                    <span class="fw-bold text-dark">Tháng @ViewBag.Thang/@ViewBag.Nam</span>
                </div>

                <div class="detail-row">
                    <span class="text-muted small">Nhà cung cấp</span>
                    <span class="fw-bold text-dark">Công ty điện lực</span>
                </div>

                <div class="mt-4 pt-2">
                    <button id="btnThanhToan" class="btn btn-primary btn-pay w-100 py-3 text-white">
                        <i class="fas fa-shield-alt me-2"></i> Xác nhận thanh toán
                    </button>
                </div>
            </div>
        </div>

        <div class="text-center mt-4 pb-4">
            <div class="d-inline-flex align-items-center justify-content-center badge bg-secondary bg-opacity-10 text-muted border border-secondary border-opacity-25 rounded-pill px-3 py-2 shadow-sm">
                <i class="fas fa-shield-alt text-success me-2"></i> Đạt chuẩn PCI DSS
            </div>
            <div class="small text-muted mt-3 opacity-75">Được bảo vệ bởi mã hóa 256-bit AES</div>
        </div>
    </div>


    <div id="successScreen" class="fintech-wrapper d-none">
        <div class="fintech-card text-center p-5">
            <div class="success-icon-wrap mb-4">
                <i class="fas fa-check-circle" style="font-size: 5.5rem;"></i>
            </div>

            <h3 class="fw-bold text-dark mb-2">Thanh toán thành công!</h3>
            <p class="text-muted mb-4">Giao dịch của bạn đã được ghi nhận vào hệ thống.</p>

            <div class="bg-light rounded-3 p-3 mb-4 text-start">
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted small">Mã GD:</span>
                    <span class="fw-bold text-dark font-monospace">TXN-@DateTime.Now.Ticks.ToString().Substring(0, 8)</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="text-muted small">Thời gian:</span>
                    <span class="fw-bold text-dark small">@DateTime.Now.ToString("dd/MM/yyyy HH:mm")</span>
                </div>
            </div>

            <button onclick="window.close()" class="btn btn-light border w-100 py-3 fw-bold text-primary rounded-pill">
                Về trang chủ
            </button>
        </div>
    </div>

    <script>
        document.getElementById('btnThanhToan').addEventListener('click', function () {
            let btn = this;

            // Đổi trạng thái nút
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> Đang xử lý...';
            btn.style.background = '#6c757d'; // Đổi sang xám
            btn.style.boxShadow = 'none';
            btn.disabled = true;

            let billId = '@ViewBag.HoaDonId';

            // Giả lập độ trễ mạng để khách hàng thấy sự "chuyên nghiệp"
            setTimeout(() => {
                fetch(`/ThanhToan/XacNhanThanhToan?id=${billId}`, {
                    method: 'POST',
                    headers: { 'ngrok-skip-browser-warning': 'true' }
                })
                .then(res => {
                    if (!res.ok) { throw new Error('Server C# bị lỗi nội bộ (500)'); }
                    return res.json();
                })
                .then(data => {
                    if(data.success) {
                        // CHUYỂN MÀN HÌNH THÀNH CÔNG
                        document.getElementById('paymentScreen').classList.add('d-none');

                        let successScr = document.getElementById('successScreen');
                        successScr.classList.remove('d-none');
                    } else {
                        // BÁO LỖI
                        alert(data.message);
                        resetButton(btn);
                    }
                })
                .catch(err => {
                    console.error("LỖI RỒI:", err);
                    alert("Lỗi kết nối máy chủ! Hãy thử lại sau.");
                    resetButton(btn);
                });
            }, 1200);
        });

        function resetButton(btn) {
            btn.innerHTML = '<i class="fas fa-shield-alt me-2"></i> Xác nhận thanh toán';
            btn.style.background = 'linear-gradient(135deg, #0d6efd 0%, #0dcaf0 100%)';
            btn.disabled = false;
        }
    </script>
</body>
</html>